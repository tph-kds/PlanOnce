---
import BaseLayout from '../layouts/BaseLayout.astro';
import Command from '../components/Command.astro';
import WorkflowRail from '../components/WorkflowRail.astro';
import ProviderTabs from '../components/ProviderTabs.astro';
import BrandOrbit from '../components/BrandOrbit.astro';
import ProviderConstellation from '../components/ProviderConstellation.astro';
import ProviderTicker from '../components/ProviderTicker.astro';
import ReleaseFacts from '../components/ReleaseFacts.astro';
import ReliabilityLoop from '../components/ReliabilityLoop.astro';
import BorderBeam from '../components/BorderBeam.astro';
import Icon from '../components/Icon.astro';
import ProviderShowcase from '../components/ProviderShowcase.astro';
import { site } from '../data/site';
import { release } from '../data/release.generated';
import '../styles/landing.css';
const base = import.meta.env.BASE_URL;
const comparisons = [
  ['prompt drift', 'accepted plan digest'],
  ['stale tests', 'revision-bound evidence'],
  ['agent guessing', 'explicit failure route'],
  ['workspace conflicts', 'cooperative scope safety'],
];
const docsPaths = [
  ['START', 'Getting Started', 'Install, verify, route one task, and understand the single human approval moment.', `${base}docs/getting-started/`],
  ['CORE', 'Reliability Layer', 'Inspect the plan fingerprint, evidence freshness, failure routing, and workspace contract.', `${base}docs/reliability/`],
  ['REFERENCE', 'Artifact Schemas', 'Read the durable CONTEXT, DESIGN, PLAN, STATE, and VERIFY artifact contract.', `${base}docs/artifacts/`],
];
---
<BaseLayout title="PlanOnce" description="Open-source production engineering control for building high-quality software with any AI coding agent.">
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy-block">
        <div class="eyebrow reveal"><span class="status-dot"></span> Open source production engineering control</div>
        <h1 class="reveal">One plan.<br/>Every agent.<br/><em>Production that holds.</em></h1>
        <p class="hero-copy reveal">Route work, freeze accepted intent, execute inside a bounded scope, and ship only from fresh evidence — across the coding agents your team already uses.</p>
        <div class="hero-actions reveal">
          <BorderBeam><a class="button button-primary" href={`${base}docs/getting-started/`}>Start with PlanOnce <Icon name="arrow-right" size={16} /></a></BorderBeam>
          <a class="button-quiet" href={`${base}docs/workflows/`}>Read the workflow model</a>
        </div>
        <div class="hero-command reveal"><Command command={site.install} label="Copy the PlanOnce install command" /></div>
        <div class="hero-trust reveal">
          <span><Icon name="shield" size={14} /> {release.skillCount} Agent Skills</span>
          <span>•</span><span>Agent OS {release.agentOsVersion} + GSD {release.gsdVersion}</span>
          <span>•</span><span>Fresh evidence, not stale confidence</span>
        </div>
      </div>
      <div class="reveal"><BrandOrbit /></div>
    </div>
  </section>

  <ProviderShowcase />
  <ReleaseFacts />
  <ProviderConstellation />
  <ProviderTicker />

  <section class="section" id="why">
    <div class="container">
      <div class="section-intro reveal">
        <div><div class="kicker">Why PlanOnce</div><h2 class="display">AI moves fast.<br/>Engineering needs memory.</h2></div>
        <p>A coding agent can generate changes quickly. Production engineering still needs accepted intent, explicit recovery, fresh verification, and a human-readable decision trail. PlanOnce turns those promises into one durable workflow contract.</p>
      </div>
      <div class="compare-panel reveal">
        <div class="compare-col">
          <h3>Without PlanOnce</h3>
          <p class="muted">Each new prompt can silently redefine the work.</p>
        </div>
        <div class="compare-col">
          <h3>With PlanOnce</h3>
          <div class="compare-list">
            {comparisons.map(([before, after]) => <div class="compare-row"><span>{before}</span><i>→</i><strong>{after}</strong></div>)}
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="control-loop-heading">
    <div class="container control-story">
      <div class="control-story-copy reveal">
        <div class="kicker">The PlanOnce control loop</div>
        <h2 id="control-loop-heading" class="display">Accepted intent stays at the center.</h2>
        <p>Motion is useful here because the product is a state machine: approved planning authority becomes bounded execution, bounded execution produces fresh evidence, and evidence reaches a human ship decision.</p>
      </div>
      <div class="evidence-chain reveal">
        <div class="evidence-step"><span>01</span><div><h3>APPROVED PLAN</h3><p>One accepted planning authority establishes the scope and digest.</p></div></div>
        <div class="evidence-arrow"></div>
        <div class="evidence-step"><span>02</span><div><h3>BOUND EXECUTION</h3><p>Agents work inside the approved plan and cooperative workspace rules.</p></div></div>
        <div class="evidence-arrow"></div>
        <div class="evidence-step"><span>03</span><div><h3>FRESH EVIDENCE</h3><p>Verification is revision-bound; relevant changes invalidate prior proof.</p></div></div>
        <div class="evidence-arrow"></div>
        <div class="evidence-step"><span>04</span><div><h3>HUMAN SHIP</h3><p>A human sees readiness, backlog, and blocking evidence before release.</p></div></div>
      </div>
    </div>
  </section>

  <section class="section" id="workflows">
    <div class="container">
      <div class="section-intro reveal">
        <div><div class="kicker">Six implementation routes</div><h2 class="display">Greenfield or Brownfield.<br/>Small, Normal, or Large.</h2></div>
        <p><code>planonce-task</code> classifies only enough context to choose the smallest safe route, then exits. The selected workflow becomes the single planning authority.</p>
      </div>
      <WorkflowRail />
    </div>
  </section>

  <section class="section" id="reliability">
    <div class="container">
      <div class="section-intro reveal">
        <div><div class="kicker">Workflow Reliability Layer</div><h2 class="display">Route. Freeze. Execute. Prove. Recover. Review.</h2></div>
        <p>Reliability is shown as a connected control loop instead of six disconnected feature cards. The failure fork matters: defects return to verification; plan contradictions return to human approval.</p>
      </div>
      <ReliabilityLoop />
    </div>
  </section>

  <section class="section" id="security">
    <div class="container">
      <div class="section-intro reveal">
        <div><div class="kicker">Security + readiness</div><h2 class="display">A security scan is not a ship decision.</h2></div>
        <p>PlanOnce keeps security finding validation separate from production readiness, so a clean scan cannot hide missing correctness, operations, or evidence.</p>
      </div>
      <div class="security-readiness">
        <article class="gate-card reveal"><span class="icon-gem" aria-hidden="true"><Icon name="shield" size={20} /></span><h3>Security</h3><p>Finding → verify → finding-scoped fix → reverify. External skills and hooks also receive supply-chain review.</p><div class="status-row"><span class="status-chip">verified finding</span><span class="status-chip">scoped fix</span></div></article>
        <article class="gate-card reveal"><span class="icon-gem" aria-hidden="true"><Icon name="route" size={20} /></span><h3>Readiness</h3><p>Correctness + fresh evidence + operations + backlog become one explicit release status.</p><div class="status-row"><span class="status-chip">READY</span><span class="status-chip">READY_WITH_BACKLOG</span><span class="status-chip blocked">NOT_READY / BLOCKED</span></div></article>
      </div>
    </div>
  </section>

  <section class="section architecture" id="architecture">
    <div class="container">
      <div class="section-intro reveal">
        <div><div class="kicker">Runtime architecture</div><h2 class="display">One authority. Supporting engines underneath.</h2></div>
        <p>PlanOnce compiles the useful standards and execution semantics into portable Agent Skills. Agent OS and GSD are sources beneath the authority boundary, not three competing orchestrators.</p>
      </div>
      <div class="authority-map reveal">
        <div class="authority-node"><span>Human + repository policy</span><strong>Accepted engineering intent</strong></div>
        <div class="authority-arrow">↓</div>
        <div class="authority-node primary"><span>Sole orchestration authority</span><strong>PlanOnce v{release.version}</strong></div>
        <div class="authority-arrow">↙ &nbsp;&nbsp;&nbsp;&nbsp; ↘</div>
        <div class="authority-sources"><div class="authority-node"><span>Standards source</span><strong>Agent OS {release.agentOsVersion}</strong></div><div class="authority-node"><span>Execution / audit source</span><strong>GSD Core {release.gsdVersion}</strong></div></div>
        <div class="authority-arrow">↓</div>
        <div class="authority-output"><span>portable Agent Skills</span><span>provider-neutral contracts</span><span>fresh evidence</span></div>
      </div>
    </div>
  </section>

  <section class="section" id="install">
    <div class="container">
      <div class="install-lab">
        <div class="install-heading reveal"><div class="kicker">Provider installation lab</div><h2 class="display">Pick your agent. Copy one exact command.</h2><p>The selector renders one live installation panel instead of fourteen duplicated code panels. Project/global paths and provider-specific caveats remain visible.</p></div>
        <ProviderTabs />
      </div>
    </div>
  </section>

  <section class="section" id="docs">
    <div class="container">
      <div class="section-intro reveal"><div><div class="kicker">Documentation pathways</div><h2 class="display">Start fast. Inspect deeply when needed.</h2></div><p>The docs are grouped around starting, core concepts, operations, and reference material so daily use does not require hunting through a flat sidebar.</p></div>
      <div class="docs-paths reveal">
        {docsPaths.map(([group, title, copy, href]) => <a class="docs-path" href={href}><span>{group}</span><h3>{title}</h3><p>{copy}</p><strong>Open documentation →</strong></a>)}
      </div>
    </div>
  </section>

  <section class="section" id="faq">
    <div class="container">
      <div class="section-intro reveal"><div><div class="kicker">FAQ</div><h2 class="display">The important constraints, upfront.</h2></div><p>PlanOnce stays lightweight by using the smallest safe workflow, one approval boundary, and portable artifacts instead of adding a permanent orchestration service.</p></div>
      <div class="faq reveal">
        <details><summary>Does PlanOnce replace my coding agent?</summary><p>No. PlanOnce supplies provider-neutral workflows, artifacts, safety gates, verification, and review. Your selected agent still performs the coding work.</p></details>
        <details><summary>Do users need Agent OS and GSD separately?</summary><p>No. PlanOnce is the user-facing authority. Upstream semantics are compiled into self-contained skills rather than exposed as competing root command surfaces.</p></details>
        <details><summary>What happens when verification fails?</summary><p>Defect → <code>FIX_REVERIFY</code>. Plan contradiction → <code>BLOCKED_AMEND</code> + human amendment. Uncertainty → <code>DIAGNOSE</code>.</p></details>
        <details><summary>Can stale passing tests count?</summary><p>No. Evidence is bound to revision, relevant worktree state, and the accepted plan digest. Relevant changes invalidate it until verification reruns.</p></details>
        <details><summary>Does every task need Large?</summary><p>No. The router selects the smallest safe workflow. Large exists for coordination and risk, not prestige.</p></details>
      </div>
    </div>
  </section>
</BaseLayout>
