---
import { providers } from '../data/providers';

const firstRow = providers.filter(p => p.tier === 'first-class');
const secondRow = [...providers.filter(p => p.tier === 'extended'), ...providers.slice(0,3)];

// dark/light variants — researched via simpleicons & official sites
// simpleicons CDN allows color param: /<slug>/<hex>
// fallback badge for niche providers (Kilo, Kiro, Roo, OpenHands, Goose custom)
const logos: Record<string, { light: string; dark: string; isBadge?: boolean; label?: string }> = {
  'claude-code': { light: 'https://cdn.simpleicons.org/anthropic/0B1220', dark: 'https://cdn.simpleicons.org/anthropic/FFFFFF' },
  'codex': { light: 'https://cdn.jsdelivr.net/npm/simple-icons@13/icons/openai.svg', dark: 'https://cdn.jsdelivr.net/npm/simple-icons@13/icons/openai.svg' },
  'opencode': { light: 'https://cdn.simpleicons.org/opencode/0B1220', dark: 'https://cdn.simpleicons.org/opencode/FFFFFF' },
  'cursor': { light: 'https://cdn.simpleicons.org/cursor/0B1220', dark: 'https://cdn.simpleicons.org/cursor/FFFFFF' },
  'gemini-cli': { light: 'https://cdn.simpleicons.org/googlegemini/0B1220', dark: 'https://cdn.simpleicons.org/googlegemini/FFFFFF' },
  'github-copilot': { light: 'https://cdn.simpleicons.org/githubcopilot/0B1220', dark: 'https://cdn.simpleicons.org/githubcopilot/FFFFFF' },
  'cline': { light: 'https://cdn.simpleicons.org/cline/0B1220', dark: 'https://cdn.simpleicons.org/cline/FFFFFF' },
  'kilo': { light: '', dark: '', isBadge: true, label: 'KI' },
  'kiro-cli': { light: '', dark: '', isBadge: true, label: 'KI' },
  'roo': { light: '', dark: '', isBadge: true, label: 'RO' },
  'windsurf': { light: 'https://cdn.simpleicons.org/windsurf/0B1220', dark: 'https://cdn.simpleicons.org/windsurf/FFFFFF' },
  'qwen-code': { light: 'https://cdn.simpleicons.org/qwen/0B1220', dark: 'https://cdn.simpleicons.org/qwen/FFFFFF' },
  'goose': { light: '', dark: '', isBadge: true, label: 'GO' },
  'openhands': { light: '', dark: '', isBadge: true, label: 'OH' },
};

const chip = (p: typeof providers[number]) => {
  const l = logos[p.id] || { light: '', dark: '', isBadge: true, label: p.name.slice(0,2).toUpperCase() };
  const isBadge = l.isBadge;
  const hasImg = !isBadge && l.light;
  return { p, l, isBadge, hasImg };
};
const renderChip = (items: typeof providers) => items.map(c => chip(c));
---
<section class="marquee-section" aria-label="Supported providers">
  <div class="container marquee-heading">
    <strong>Works where you work — 14 runtimes, one vocabulary</strong>
    <span>Provider-neutral • No lock-in</span>
  </div>
  <div class="marquee-wrap">
    <div class="marquee-track">
      {[...renderChip(firstRow), ...renderChip(firstRow)].map(({p,l,isBadge,hasImg}) => (
        <div class="provider-chip">
          {isBadge ? (
            <span class="logo-fallback" aria-hidden="true">{l.label}</span>
          ) : hasImg ? (
            <span class="logo-wrap" aria-hidden="true">
              <img class="logo-img logo-light" src={l.light} alt="" width="18" height="18" loading="lazy" />
              <img class="logo-img logo-dark" src={l.dark} alt="" width="18" height="18" loading="lazy" />
            </span>
          ) : null}
          {p.name}
          <span class="tier">first-class</span>
        </div>
      ))}
    </div>
  </div>
  <div class="marquee-wrap">
    <div class="marquee-track reverse">
      {[...renderChip(secondRow), ...renderChip(secondRow)].map(({p,l,isBadge,hasImg}) => (
        <div class={`provider-chip ${p.tier === 'extended' ? 'extended' : ''}`}>
          {isBadge ? (
            <span class="logo-fallback" aria-hidden="true">{l.label}</span>
          ) : hasImg ? (
            <span class="logo-wrap" aria-hidden="true">
              <img class="logo-img logo-light" src={l.light} alt="" width="18" height="18" loading="lazy" />
              <img class="logo-img logo-dark" src={l.dark} alt="" width="18" height="18" loading="lazy" />
            </span>
          ) : null}
          {p.name}
          <span class="tier">{p.tier}</span>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .logo-wrap { width:24px;height:24px;border-radius:7px;background:var(--paper-2);border:1px solid var(--line);display:grid;place-items:center;flex:none;position:relative;overflow:hidden; }
  .logo-img { width:15px;height:15px;object-fit:contain; position:absolute; inset:0; margin:auto; }
  .logo-light { opacity:1; }
  .logo-dark { opacity:0; }
  [data-theme='dark'] .logo-light { opacity:0; }
  [data-theme='dark'] .logo-dark { opacity:1; }
  /* openai/Codex single SVG needs invert for dark */
  [data-theme='dark'] .logo-dark[src*="openai"] { filter: invert(1) brightness(1.6); }
  /* kilo/kiro/openhands single source needs invert for dark */
  [data-theme='dark'] .logo-dark[src*="raw.githubusercontent"], [data-theme='dark'] .logo-dark[src*="kiro.dev"], [data-theme='dark'] .logo-dark[src*="assets.openhands"] { filter: brightness(0) invert(1) contrast(1.05); }
  .logo-fallback { width:24px;height:24px;border-radius:7px;background:linear-gradient(135deg,var(--accent),var(--brand-violet));color:#fff;display:grid;place-items:center;font-size:.58rem;font-weight:900;letter-spacing:.02em;flex:none; }
  .provider-chip img[loading="lazy"] { transition: opacity 180ms ease; }
</style>
