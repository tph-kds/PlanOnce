---
const base = import.meta.env.BASE_URL;
---

<div class="brand-orbit" data-brand-orbit aria-label="PlanOnce control orbit: Plan, Build, Prove, Human Ship">
  <div class="moon-stage">
    <div class="dish" aria-hidden="true"></div>
    <div class="dish-edge" aria-hidden="true"></div>

    <div class="halo halo--far" aria-hidden="true"></div>
    <div class="halo halo--mid" aria-hidden="true"></div>
    <div class="halo halo--aura" aria-hidden="true"></div>

    <div class="orbit-ring orbit-ring--outer" aria-hidden="true"></div>
    <div class="orbit-ring orbit-ring--inner" aria-hidden="true"></div>

    <div class="guiding-star" aria-hidden="true"><span>✦</span></div>

    <div class="orbit-trail" aria-hidden="true">
      <span class="trail-dot trail-dot--1"></span>
      <span class="trail-dot trail-dot--2"></span>
      <span class="trail-dot trail-dot--3"></span>
      <span class="trail-node"><span class="trail-node-core"></span></span>
    </div>
    <div class="spoke" aria-hidden="true"></div>

    <div class="moon-wrap">
      <img
        class="moon-img moon-img--light"
        src={`${base}brand/planonce-mark-light.png`}
        alt=""
        width="520"
        height="520"
        loading="eager"
        decoding="async"
        fetchpriority="high"
        aria-hidden="true"
      />
      <img
        class="moon-img moon-img--dark"
        src={`${base}brand/planonce-mark-dark.png`}
        alt="PlanOnce — crescent moon with orbit"
        width="520"
        height="520"
        loading="eager"
        decoding="async"
        fetchpriority="high"
      />
      <img
        class="moon-img moon-img--primary"
        src={`${base}brand/planonce-mark-primary.png`}
        alt=""
        width="520"
        height="520"
        loading="eager"
        aria-hidden="true"
      />
      <div class="moon-highlight" aria-hidden="true"></div>
      <div class="moon-shadow" aria-hidden="true"></div>
    </div>

    <div class="orbit-node n-plan" data-orbit-node tabindex="0" role="note" aria-label="Plan — approved digest">
      <span class="node-dot" aria-hidden="true"></span>
      <span class="node-label">PLAN</span>
    </div>
    <div class="orbit-node n-build" data-orbit-node tabindex="0" role="note" aria-label="Build — bounded waves">
      <span class="node-dot" aria-hidden="true"></span>
      <span class="node-label">BUILD</span>
    </div>
    <div class="orbit-node n-prove" data-orbit-node tabindex="0" role="note" aria-label="Prove — fresh evidence">
      <span class="node-dot" aria-hidden="true"></span>
      <span class="node-label">PROVE</span>
    </div>
    <div class="orbit-node n-ship is-featured" data-orbit-node tabindex="0" role="note" aria-label="Human Ship — human decision">
      <span class="node-star" aria-hidden="true">✦</span>
      <span class="node-label">HUMAN SHIP</span>
    </div>
  </div>
  <p class="orbit-caption" aria-hidden="true"><span>PLAN</span><i>→</i><span>BUILD</span><i>→</i><span>PROVE</span><i>→</i><strong>HUMAN SHIP</strong></p>
</div>

<style>
.brand-orbit{
  width:100%; max-width:560px; margin-inline:auto; padding:10px 0 8px; isolation:isolate; overflow:visible;
}
.moon-stage{
  position:relative; width:100%; aspect-ratio:1.18; display:grid; place-items:center; perspective:960px;
  transform-style:preserve-3d; overflow:visible;
}

/* Portal: dark subtle lens — blends with dark page, avoids bright white blob */
.dish{
  position:absolute; inset:6% 4% 8% 4%; border-radius:50% / 46%;
  background:
    radial-gradient(ellipse at 50% 44%, color-mix(in srgb, var(--violet) 05%, transparent) 0%, transparent 52%),
    radial-gradient(ellipse at 50% 62%, color-mix(in srgb, var(--cyan) 04%, transparent) 0%, transparent 58%);
  border:1px solid color-mix(in srgb, var(--line) 18%, transparent);
  box-shadow:
    inset 0 1px 0 rgba(255,255,255,.18),
    inset 0 -14px 28px rgba(99,102,241,.06),
    0 8px 28px rgba(15,23,42,.05);
  backdrop-filter: blur(10px) saturate(1.06);
  -webkit-backdrop-filter: blur(10px) saturate(1.06);
  pointer-events:none;
}
.dish-edge{
  position:absolute; inset:5.5% 3.5% 7.5% 3.5%; border-radius:50% / 46%;
  border:1px solid color-mix(in srgb, var(--line) 22%, transparent); opacity:.28; pointer-events:none;
}
[data-theme='dark'] .dish{
  background:
    radial-gradient(ellipse at 50% 44%, color-mix(in srgb, #12153a 28%, transparent) 0%, transparent 56%),
    radial-gradient(ellipse at 50% 62%, color-mix(in srgb, var(--violet) 06%, transparent) 0%, transparent 62%);
  border-color: color-mix(in srgb, #2a3568 20%, transparent);
  box-shadow:
    inset 0 1px 0 rgba(255,255,255,.04),
    inset 0 -16px 36px rgba(0,0,0,.22),
    0 14px 36px rgba(0,0,0,.22);
  backdrop-filter: blur(12px) saturate(1.08);
  -webkit-backdrop-filter: blur(12px) saturate(1.08);
}
[data-theme='dark'] .dish-edge{
  border-color: color-mix(in srgb, #2a3565 18%, transparent); opacity:.18;
}

/* Halos */
.halo{
  position:absolute; left:50%; top:50%; border-radius:50%; pointer-events:none;
  transform: translate(-50%,-50%); opacity:0; will-change: transform, opacity;
}
.halo--far{
  width:86%; height:64%;
  background: radial-gradient(ellipse at 50% 50%, color-mix(in srgb, var(--violet) 08%, transparent) 0%, color-mix(in srgb, var(--violet) 04%, transparent) 40%, transparent 74%);
  filter: blur(28px); animation: halo-enter .9s cubic-bezier(.22,1,.36,1) .08s forwards, halo-breath 7s ease-in-out 1.3s infinite;
  --halo-o:.42;
}
.halo--mid{
  width:68%; height:50%;
  background: radial-gradient(ellipse at 48% 44%, color-mix(in srgb, var(--accent) 06%, transparent) 0%, color-mix(in srgb, var(--cyan) 05%, transparent) 46%, transparent 72%);
  filter: blur(20px); animation: halo-enter .85s cubic-bezier(.22,1,.36,1) .14s forwards, halo-breath 7s ease-in-out 1.5s infinite reverse;
  --halo-o:.38;
}
.halo--aura{
  width:44%; height:32%;
  background: radial-gradient(ellipse at 50% 50%, color-mix(in srgb, var(--accent) 05%, transparent) 0%, transparent 70%);
  filter: blur(14px); animation: halo-enter .7s ease .2s forwards; --halo-o:.36;
}
[data-theme='dark'] .halo--far{ background: radial-gradient(ellipse at 50% 50%, color-mix(in srgb, var(--violet) 14%, transparent) 0%, color-mix(in srgb, var(--violet) 07%, transparent) 40%, transparent 74%); --halo-o:.54; }
[data-theme='dark'] .halo--mid{ background: radial-gradient(ellipse at 48% 44%, color-mix(in srgb, var(--accent) 10%, transparent) 0%, color-mix(in srgb, var(--cyan) 08%, transparent) 46%, transparent 72%); --halo-o:.48; }
[data-theme='dark'] .halo--aura{ background: radial-gradient(ellipse at 50% 50%, color-mix(in srgb, var(--accent) 08%, transparent) 0%, transparent 70%); --halo-o:.42; }
@keyframes halo-enter{ from{ opacity:0; transform: translate(-50%,-50%) scale(.88)} to{ opacity:1; transform: translate(-50%,-50%) scale(1)} }
@keyframes halo-breath{ 0%,100%{ transform: translate(-50%,-50%) scale(1); opacity: var(--halo-o)} 50%{ transform: translate(-50%,-50%) scale(1.06); opacity: calc(var(--halo-o) * 1.1)} }

/* Rings */
.orbit-ring{
  position:absolute; left:50%; top:50%; border-radius:50%; pointer-events:none;
  transform: translate(-50%,-50%) rotateX(64deg) rotateZ(-6deg); will-change: transform, opacity; opacity:0;
}
.orbit-ring--outer{
  width:90%; height:71%; border:1px solid color-mix(in srgb, #b8c4f0 28%, transparent);
  box-shadow: 0 0 0 1px color-mix(in srgb, var(--accent) 05%, transparent), inset 0 0 14px color-mix(in srgb, var(--accent) 04%, transparent);
  animation: ring-enter .72s cubic-bezier(.22,1,.36,1) .32s forwards;
}
.orbit-ring--inner{
  width:84%; height:66%; border:1px solid color-mix(in srgb, #ccd4ff 26%, transparent 74%);
  box-shadow: inset 0 0 14px color-mix(in srgb, var(--violet) 04%, transparent);
  animation: ring-enter .68s cubic-bezier(.22,1,.36,1) .42s forwards;
  transform: translate(-50%,-50%) rotateX(64deg) rotateZ(-6deg) translateZ(-8px);
}
[data-theme='dark'] .orbit-ring--outer{
  border-color: color-mix(in srgb, #3a4a9a 28%, transparent 72%);
  box-shadow: 0 0 0 1px color-mix(in srgb, var(--accent) 10%, transparent), inset 0 0 14px color-mix(in srgb, var(--accent) 05%, transparent);
}
[data-theme='dark'] .orbit-ring--inner{ border-color: color-mix(in srgb, #2a3565 22%, transparent 78%); }
@keyframes ring-enter{ from{ opacity:0; transform: translate(-50%,-50%) rotateX(64deg) rotateZ(-6deg) scale(.94)} to{ opacity:.92; transform: translate(-50%,-50%) rotateX(64deg) rotateZ(-6deg) scale(1)} }

/* Guiding star */
.guiding-star{
  position:absolute; left:74.5%; top:26.5%; width:28px; height:28px; display:grid; place-items:center;
  transform: translate(-50%,-50%) rotate(-8deg); pointer-events:none; opacity:0; z-index:3;
  animation: star-enter .6s cubic-bezier(.22,1,.36,1) .9s forwards, star-float 5.2s ease-in-out 1.4s infinite;
}
.guiding-star span{
  font-size:22px; line-height:1;
  background: linear-gradient(135deg, var(--accent) 0%, var(--violet) 58%, #7be1ff 100%);
  -webkit-background-clip:text; background-clip:text; -webkit-text-fill-color: transparent;
  filter: drop-shadow(0 2px 10px color-mix(in srgb, var(--violet) 28%, transparent)) drop-shadow(0 0 14px color-mix(in srgb, var(--cyan) 22%, transparent));
}
[data-theme='dark'] .guiding-star span{
  filter: drop-shadow(0 2px 12px rgba(0,0,0,.32)) drop-shadow(0 0 16px color-mix(in srgb, var(--violet) 42%, transparent));
}
@keyframes star-enter{ from{ opacity:0; transform: translate(-50%,-50%) rotate(-8deg) scale(.72)} to{ opacity:1; transform: translate(-50%,-50%) rotate(-8deg) scale(1)} }
@keyframes star-float{ 0%,100%{ transform: translate(-50%,-50%) rotate(-8deg) translateY(0)} 50%{ transform: translate(-50%,-50%) rotate(-8deg) translateY(-4px)} }

/* Trail */
.orbit-trail{ position:absolute; inset:0; pointer-events:none; z-index:2; }
.trail-dot{
  position:absolute; width:8px; height:8px; border-radius:50%;
  background: radial-gradient(circle at 30% 30%, #8de8ff 0%, var(--cyan) 22%, var(--accent) 52%, var(--violet) 82%);
  box-shadow: 0 2px 10px color-mix(in srgb, var(--accent) 22%, transparent), 0 0 0 3px color-mix(in srgb, var(--paper) 86%, transparent);
  transform: translate(-50%,-50%); opacity:0; animation: node-enter .4s cubic-bezier(.22,1,.36,1) forwards;
}
[data-theme='dark'] .trail-dot{ box-shadow: 0 2px 10px rgba(0,0,0,.32), 0 0 0 3px color-mix(in srgb, var(--paper-2) 62%, transparent); }
.trail-dot--1{ left:70%; top:71%; animation-delay:.96s; width:7px; height:7px; opacity:.88; }
.trail-dot--2{ left:66%; top:74.5%; animation-delay:1.02s; width:6px; height:6px; opacity:.96; }
.trail-dot--3{ left:62.5%; top:77.8%; animation-delay:1.08s; width:5px; height:5px; opacity:.92; }
.trail-node{
  position:absolute; left:27.5%; top:62%; width:18px; height:18px; border-radius:50%;
  background: white; border:1px solid color-mix(in srgb, var(--line) 86%, transparent);
  box-shadow: 0 4px 16px rgba(15,23,42,.12), 0 0 0 4px color-mix(in srgb, var(--paper) 72%, transparent);
  display:grid; place-items:center; transform: translate(-50%,-50%); opacity:0;
  animation: node-enter .42s cubic-bezier(.22,1,.36,1) 1.14s forwards; z-index:2;
}
[data-theme='dark'] .trail-node{ background: #eef3ff; border-color: color-mix(in srgb, var(--line) 42%, transparent); box-shadow: 0 4px 16px rgba(0,0,0,.28), 0 0 0 4px color-mix(in srgb, var(--paper-2) 38%, transparent); }
.trail-node-core{ width:8px; height:8px; border-radius:50%; background: radial-gradient(circle at 30% 30%, #7be1ff 0%, var(--accent) 56%, var(--violet) 88%); box-shadow: 0 1px 6px color-mix(in srgb, var(--accent) 32%, transparent); }
.spoke{
  position:absolute; left:32%; top:60%; width:18%; height:1px;
  background: linear-gradient(90deg, color-mix(in srgb, var(--accent) 18%, transparent) 0%, color-mix(in srgb, var(--accent) 28%, transparent) 42%, transparent 100%);
  transform-origin: left center; transform: translateY(-50%) rotate(10deg); opacity:0;
  animation: spoke-enter .5s ease 1.18s forwards; pointer-events:none; z-index:1;
}
[data-theme='dark'] .spoke{ background: linear-gradient(90deg, color-mix(in srgb, var(--accent) 22%, transparent) 0%, color-mix(in srgb, var(--cyan) 16%, transparent) 42%, transparent 100%); }
@keyframes spoke-enter{ from{ opacity:0; transform: translateY(-50%) rotate(10deg) scaleX(.72)} to{ opacity:.92; transform: translateY(-50%) rotate(10deg) scaleX(1)} }

/* Moon */
.moon-wrap{
  position:absolute; left:50%; top:50%; width: min(100%, 294px); aspect-ratio:1;
  display:grid; place-items:center; place-content:center;
  transform: translate(-50%,-50%) translateZ(18px); transform-style: preserve-3d; opacity:0;
  animation: brand-enter .72s cubic-bezier(.22,1,.36,1) .18s forwards, moon-float 6.8s ease-in-out 1.35s infinite;
  z-index:4; will-change: transform, opacity;
  filter: drop-shadow(0 22px 36px rgba(18,24,68,.10)) drop-shadow(0 8px 18px rgba(81,71,230,.09));
  transition: filter .32s ease;
}
.moon-wrap:hover{ filter: drop-shadow(0 26px 44px rgba(18,24,68,.14)) drop-shadow(0 10px 22px rgba(81,71,230,.14)); }
.moon-wrap::before{
  content:''; position:absolute; inset: -10% -10% -10% -10%; border-radius:50%;
  background: radial-gradient(circle at 50% 45%, color-mix(in srgb, var(--accent) 14%, transparent) 0%, color-mix(in srgb, var(--violet) 09%, transparent) 45%, transparent 70%);
  filter: blur(22px); pointer-events:none; z-index:-1;
}
[data-theme='dark'] .moon-wrap{
  filter: drop-shadow(0 28px 48px rgba(0,0,0,.32)) drop-shadow(0 10px 22px rgba(81,71,230,.18));
}
[data-theme='dark'] .moon-wrap:hover{ filter: drop-shadow(0 32px 56px rgba(0,0,0,.38)) drop-shadow(0 12px 26px rgba(81,71,230,.24)); }
[data-theme='dark'] .moon-wrap::before{
  background: radial-gradient(circle at 50% 45%, color-mix(in srgb, var(--violet) 18%, transparent) 0%, color-mix(in srgb, var(--accent) 12%, transparent) 45%, transparent 70%);
}
@keyframes brand-enter{ from{ opacity:0; transform: translate(-50%,-50%) translateZ(18px) scale(.94)} to{ opacity:1; transform: translate(-50%,-50%) translateZ(18px) scale(1)} }
@keyframes moon-float{ 0%,100%{ transform: translate(-50%,-50%) translateZ(18px) translateY(0)} 50%{ transform: translate(-50%,-50%) translateZ(18px) translateY(-6px)} }
.moon-img{ width:100%; height:100%; object-fit:contain; object-position:center; display:block; grid-area:1/1; transition: opacity .32s ease, filter .3s ease, transform .45s cubic-bezier(.22,1,.36,1); }
.moon-img--light{ opacity:1; }
.moon-img--dark{ opacity:0; }
.moon-img--primary{ opacity:0; pointer-events:none; }
[data-theme='dark'] .moon-img--light{ opacity:0; }
[data-theme='dark'] .moon-img--dark{ opacity:1; }
.moon-wrap:hover .moon-img--light, .moon-wrap:hover .moon-img--dark{ transform: scale(1.015); filter: saturate(1.08) brightness(1.02); }
.moon-highlight{
  position:absolute; inset: 6% 10% 18% 8%; border-radius: 46% / 40%;
  background: radial-gradient(ellipse at 24% 20%, rgba(255,255,255,.22) 0%, rgba(255,255,255,.08) 18%, transparent 46%);
  mix-blend-mode: overlay; pointer-events:none; opacity:.82;
}
[data-theme='dark'] .moon-highlight{ opacity:.34; }
.moon-shadow{
  position:absolute; left:50%; bottom: 2%; width:58%; height:14%; transform: translateX(-50%);
  background: radial-gradient(ellipse at 50% 50%, rgba(15,23,42,.14) 0%, transparent 72%);
  filter: blur(8px); pointer-events:none; opacity:.68;
}
[data-theme='dark'] .moon-shadow{ background: radial-gradient(ellipse at 50% 50%, rgba(0,0,0,.36) 0%, transparent 72%); }

/* Nodes */
.orbit-node{
  position:absolute; display:inline-flex; align-items:center; gap:7px; min-height:30px;
  padding:6px 11px 6px 7px; border-radius:999px;
  background: color-mix(in srgb, var(--paper) 66%, transparent);
  border:1px solid color-mix(in srgb, var(--line) 62%, transparent);
  box-shadow: 0 8px 22px rgba(15,23,42,.07), 0 1px 0 rgba(255,255,255,.55) inset;
  backdrop-filter: blur(14px) saturate(1.12); -webkit-backdrop-filter: blur(14px) saturate(1.12);
  font:700 .67rem "JetBrains Mono", ui-monospace, monospace; letter-spacing:.07em; color: var(--ink-soft);
  cursor:default; opacity:0; transform: translate(-50%,-50%) scale(.88);
  animation: node-enter .44s cubic-bezier(.22,1,.36,1) forwards;
  will-change: transform, opacity;
  transition: box-shadow .2s ease, border-color .2s ease, background .2s ease, color .2s ease, transform .2s ease;
  white-space: nowrap; z-index:5;
}
@keyframes node-enter{ from{ opacity:0; transform: translate(-50%,-50%) scale(.88)} to{ opacity:1; transform: translate(-50%,-50%) scale(1)} }
[data-theme='dark'] .orbit-node{
  background: color-mix(in srgb, var(--paper-2) 52%, transparent);
  border-color: color-mix(in srgb, var(--line) 40%, transparent);
  color: var(--ink);
  box-shadow: 0 10px 26px rgba(0,0,0,.28), 0 1px 0 rgba(255,255,255,.05) inset;
}
.orbit-node:hover, .orbit-node:focus-visible{
  transform: translate(-50%,-50%) scale(1.05) translateY(-1px);
  border-color: color-mix(in srgb, var(--accent) 22%, var(--line));
  box-shadow: 0 12px 28px rgba(81,71,230,.16); color: var(--ink); outline:none;
}
[data-theme='dark'] .orbit-node:hover, [data-theme='dark'] .orbit-node:focus-visible{
  border-color: color-mix(in srgb, var(--accent) 30%, var(--line));
  box-shadow: 0 14px 30px rgba(0,0,0,.42);
}
.n-plan{ left: 13.5%; top: 20%; animation-delay:.52s; }
.n-build{ left: 12.5%; top: 76%; animation-delay:.62s; }
.n-prove{ left: 73%; top: 84.5%; animation-delay:.72s; }
.n-ship{ left: 85%; top: 22%; animation-delay:.82s; }
.orbit-node .node-dot{
  width:14px; height:14px; border-radius:50%;
  background: radial-gradient(circle at 30% 30%, #7be1ff 0%, var(--accent) 48%, var(--violet) 78%);
  box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 12%, transparent), 0 2px 8px rgba(81,71,230,.22);
  flex:none;
}
[data-theme='dark'] .orbit-node .node-dot{ box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 18%, transparent), 0 2px 8px rgba(0,0,0,.32); }
.n-ship{ gap:6px; padding-left:8px; color: var(--ink); border-color: color-mix(in srgb, var(--accent) 16%, var(--line)); background: color-mix(in srgb, var(--paper) 78%, transparent); }
[data-theme='dark'] .n-ship{ background: color-mix(in srgb, var(--paper-2) 64%, transparent); border-color: color-mix(in srgb, var(--accent) 26%, var(--line)); }
.n-ship .node-star{
  width:16px; height:16px; display:grid; place-items:center; border-radius:50%;
  background: linear-gradient(135deg, var(--violet), var(--accent)); color:white; font-size:.66rem; line-height:1;
  box-shadow: 0 4px 12px color-mix(in srgb, var(--violet) 28%, transparent); flex:none;
}
[data-theme='dark'] .n-ship .node-star{ box-shadow: 0 4px 12px rgba(0,0,0,.34); }
.n-ship .node-label{ letter-spacing:.06em; }

/* Caption */
.orbit-caption{
  text-align:center; margin:14px 0 0; display:flex; align-items:center; justify-content:center; gap:7px; flex-wrap:wrap;
  color: color-mix(in srgb, var(--muted) 80%, var(--ink) 20%);
  font:700 .64rem "JetBrains Mono", monospace; letter-spacing:.07em; text-transform: uppercase;
  opacity:0; animation: caption-enter .52s ease .96s forwards;
}
[data-theme='dark'] .orbit-caption{ color: #8ea0c3; }
@keyframes caption-enter{ from{ opacity:0; transform: translateY(4px)} to{ opacity:1; transform: translateY(0)} }
.orbit-caption i{ color: var(--accent); font-style:normal; font-weight:900; opacity:.9; }
[data-theme='dark'] .orbit-caption i{ color: #7775ff; }
.orbit-caption strong{ color: var(--ink); font-weight:800; }

@media (max-width: 900px){
  .moon-wrap{ width: min(86%, 272px); }
  .n-plan{ left: 12%; top: 18%; }
  .n-build{ left: 10%; top: 78%; }
  .n-prove{ left: 74%; top: 86%; }
  .n-ship{ left: 86%; top: 20%; }
  .guiding-star{ left: 73%; top: 24%; }
  .trail-dot--1{ left: 69%; top: 70%; }
}
@media (max-width:720px){
  .moon-wrap{ width: min(82%, 254px); }
  .orbit-node{ padding:5px 8px 5px 6px; font-size:.60rem; min-height:26px; gap:5px; }
  .orbit-node .node-dot{ width:12px; height:12px; }
  .n-ship .node-star{ width:14px; height:14px; font-size:.60rem; }
  .guiding-star{ width:24px; height:24px; left: 73%; top: 25%; }
  .guiding-star span{ font-size:18px; }
  .trail-node{ width:14px; height:14px; left: 24%; top: 60%; }
  .trail-node-core{ width:6px; height:6px; }
  .spoke{ left: 28%; width:16%; }
  .dish{ inset: 4% 2% 6% 2%; }
  .n-plan{ left: 10%; top: 14%; }
  .n-build{ left: 9%; top: 82%; }
  .n-prove{ left: 76%; top: 90%; }
  .n-ship{ left: 86%; top: 14%; }
}
@media (max-width: 480px){
  .moon-stage{ aspect-ratio: 1.08; }
  .moon-wrap{ width: min(78%, 228px); }
  .orbit-ring--outer{ width:92%; height:74%; }
  .orbit-ring--inner{ width:86%; height:68%; }
  .orbit-node{ font-size:.58rem; }
}
@media (prefers-reduced-motion: reduce){
  .halo, .orbit-ring, .moon-wrap, .orbit-node, .orbit-caption, .guiding-star, .trail-dot, .trail-node, .spoke{ animation:none !important; opacity:1 !important; }
  .moon-wrap{ transform: translate(-50%,-50%) !important; }
  .orbit-node{ transform: translate(-50%,-50%) !important; }
  .halo{ transform: translate(-50%,-50%) !important; }
}
</style>
