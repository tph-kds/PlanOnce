---
const base = import.meta.env.BASE_URL;
---
<a class="github-star" href="https://github.com/tph-kds/PlanOnce" target="_blank" rel="noreferrer" aria-label="Star PlanOnce on GitHub — view repository">
  <img class="github-star-mark github-star-mark-light" src={`${base}brand/planonce-mark-light.png`} alt="" width="20" height="20" />
  <img class="github-star-mark github-star-mark-dark" src={`${base}brand/planonce-mark-dark.png`} alt="" width="20" height="20" />
  <span class="github-star-label">
    <svg class="github-star-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 3.7l2.4 4.86 5.36.78-3.88 3.78.92 5.34L12 15.9l-4.8 2.53.92-5.34L4.24 9.34l5.36-.78L12 3.7z" fill="currentColor" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round"/></svg>
    <span class="github-star-text">GitHub</span>
    <span class="github-star-count" data-github-stars>—</span>
  </span>
</a>
<script>
  // Fetch live star count — graceful fallback if rate-limited
  const el = document.querySelector<HTMLElement>('[data-github-stars]');
  if (el) {
    const cacheKey = 'planonce-github-stars';
    const cached = localStorage.getItem(cacheKey);
    if (cached) {
      try { const { count, t } = JSON.parse(cached); if (Date.now() - t < 1000*60*60*6) el.textContent = count; } catch {}
    }
    fetch('https://api.github.com/repos/tph-kds/PlanOnce', { headers: { 'Accept': 'application/vnd.github+json' } })
      .then(r => r.ok ? r.json() : Promise.reject())
      .then(data => {
        if (typeof data.stargazers_count === 'number') {
          const fmt = data.stargazers_count >= 1000 ? (data.stargazers_count/1000).toFixed(1).replace(/\.0$/,'')+'k' : String(data.stargazers_count);
          el.textContent = fmt;
          el.title = data.stargazers_count.toLocaleString() + ' stars';
          localStorage.setItem(cacheKey, JSON.stringify({ count: fmt, t: Date.now() }));
        }
      })
      .catch(() => {
        if (el.textContent === '—') el.textContent = '★';
      });
  }
</script>
