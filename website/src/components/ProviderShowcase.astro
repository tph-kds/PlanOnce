---
import ProviderLogo from './ProviderLogo.astro';
import { providers } from '../data/providers.generated';
const firstClassProviders = providers.filter(p => p.tier === 'first-class');
const extendedProviders = providers.filter(p => p.tier === 'extended');
---
<section class="provider-showcase" aria-label="Supported providers">
  <div class="container">
    <div class="provider-showcase-header">
      <div class="kicker">Provider ecosystem</div>
      <h2 class="display">Works with your existing tools</h2>
      <p>PlanOnce is provider-neutral — same skills, same evidence contract, across 14 agents and surfaces. First-class adapters are verified end-to-end.</p>
    </div>
    
    <div class="provider-showcase-content">
      <div class="provider-tier provider-tier--first">
        <div class="tier-head">
          <div class="tier-label">
            <span class="tier-label-dot"></span>
            <h3>First-class</h3>
          </div>
          <span class="tier-count">{firstClassProviders.length} verified adapters</span>
        </div>
        <div class="provider-grid">
          {firstClassProviders.map(provider => (
            <a class="provider-item" href="#install" aria-label={provider.name}>
              <ProviderLogo provider={provider.id} size="lg" decorative={false} />
              <span class="provider-name">{provider.name}</span>
              <span class="provider-meta">{provider.projectPath}</span>
            </a>
          ))}
        </div>
      </div>
      
      <div class="provider-tier provider-tier--extended">
        <div class="tier-head">
          <div class="tier-label">
            <span class="tier-label-dot"></span>
            <h3>Extended</h3>
          </div>
          <span class="tier-count tier-count--muted">Community compatibility</span>
        </div>
        <div class="provider-grid provider-grid--extended">
          {extendedProviders.map(provider => (
            <a class="provider-item provider-item--extended" href="#install" aria-label={provider.name}>
              <ProviderLogo provider={provider.id} size="md" decorative={false} />
              <span class="provider-name">{provider.name}</span>
              <span class="provider-meta">{provider.projectPath}</span>
            </a>
          ))}
        </div>
        <div class="provider-tier-foot" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="9"/>
            <path d="M12 8v4l2.5 1.5"/>
          </svg>
          <span>Driven by community-maintained Skills CLI adapters · verified weekly</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
.provider-showcase {
  position:relative;
  padding: clamp(56px, 7vw, 88px) 0;
  background:
    radial-gradient(820px 420px at 18% 0%, color-mix(in srgb, var(--accent) 04%, transparent), transparent 68%),
    radial-gradient(640px 360px at 92% 8%, color-mix(in srgb, var(--cyan) 03%, transparent), transparent 64%),
    linear-gradient(180deg, var(--paper) 0%, color-mix(in srgb, var(--paper-2) 22%, var(--paper)) 100%);
  border-left:0;
  border-right:0;
  border-top:1px solid transparent;
  border-bottom:1px solid transparent;
  border-radius:0;
  overflow:clip;
  isolation:isolate;
}
.provider-showcase::before,
.provider-showcase::after{
  content:"";
  position:absolute;
  left:0; right:0;
  height:1px;
  z-index:2;
  background: rgba(49,64,100,0.15);
}
.provider-showcase::before{ top:0; }
.provider-showcase::after{ bottom:0; }
[data-theme='dark'] .provider-showcase{
  background:
    radial-gradient(880px 460px at 18% 0%, color-mix(in srgb, var(--violet) 08%, transparent), transparent 68%),
    radial-gradient(680px 420px at 92% 10%, color-mix(in srgb, var(--cyan) 06%, transparent), transparent 64%),
    linear-gradient(180deg, color-mix(in srgb, var(--paper) 92%, transparent) 0%, color-mix(in srgb, var(--paper-2) 14%, transparent) 100%);
  border-top-color: color-mix(in srgb, var(--line) 38%, transparent);
  border-bottom-color: color-mix(in srgb, var(--line) 38%, transparent);
}
[data-theme='dark'] .provider-showcase::before,
[data-theme='dark'] .provider-showcase::after{
  opacity:.88;
  filter: brightness(1.15) saturate(1.12);
}
@media (prefers-reduced-motion: reduce){
  .provider-showcase::before,
  .provider-showcase::after{ animation: none !important; }
  .provider-item::before{ animation: none !important; }
}

[data-theme='dark'] .provider-showcase::before,
[data-theme='dark'] .provider-showcase::after {
  background: rgba(255,255,255,0.07);
}
[data-theme='dark'] .tier-label-dot {
  box-shadow: 0 0 0 2px rgba(255,255,255,0.08);
}

.provider-showcase-header {
  text-align: center;
  max-width: 760px;
  margin: 0 auto 36px;
}
.provider-showcase-header .kicker { justify-content: center; }
.provider-showcase-header h2 { margin-top: 12px; letter-spacing:-.045em; }
.provider-showcase-header p {
  color: var(--muted);
  font-size: 1.02rem;
  line-height:1.62;
  margin-top: 10px;
  max-width: 640px;
  margin-inline:auto;
}

.provider-showcase-content {
  display: grid;
  gap: 22px;
  position: relative;
}
.provider-showcase-content > .provider-tier + .provider-tier::before{
  content: "";
  position: absolute;
  top: -11px;
  left: 50%;
  transform: translateX(-50%);
  width: 64px;
  height: 1px;
  background: color-mix(in srgb, var(--line) 90%, transparent);
}
.provider-showcase-content > .provider-tier + .provider-tier::after{
  content: "or";
  position: absolute;
  top: -19px;
  left: 50%;
  transform: translateX(-50%);
  background: var(--paper);
  color: var(--muted);
  padding: 0 10px;
  font: 600 .62rem "JetBrains Mono", monospace;
  letter-spacing: .12em;
  text-transform: uppercase;
}
[data-theme='dark'] .provider-showcase-content > .provider-tier + .provider-tier::after{
  background: color-mix(in srgb, var(--paper-2) 70%, var(--paper));
}

.provider-tier {
  padding: 28px 0 0;
}
.provider-tier--first{
  position: relative;
  border-radius: 28px;
  background:
    radial-gradient(640px 320px at 50% 0%, color-mix(in srgb, var(--accent) 05%, transparent), transparent 70%),
    color-mix(in srgb, var(--paper-2) 38%, var(--paper));
  border: 1px solid color-mix(in srgb, var(--line) 78%, transparent);
  padding: 30px 26px 28px;
  box-shadow:
    inset 0 1px 0 color-mix(in srgb, var(--paper) 92%, transparent),
    0 1px 0 color-mix(in srgb, var(--paper) 70%, transparent),
    0 18px 40px -28px rgba(15,23,42,.10);
}
.provider-tier--extended {
  padding: 24px 0 0;
  position: relative;
  border-radius: 28px;
  background:
    linear-gradient(180deg, color-mix(in srgb, var(--paper) 92%, var(--paper-2)) 0%, color-mix(in srgb, var(--paper-2) 36%, var(--paper)) 100%);
  border: 1px dashed color-mix(in srgb, var(--line) 86%, transparent);
  padding: 26px 26px 24px;
  box-shadow: inset 0 1px 0 color-mix(in srgb, var(--paper) 70%, transparent);
}
.provider-tier--extended .tier-head {
  border-bottom-color: color-mix(in srgb, var(--line) 60%, transparent);
}
.provider-tier-foot{
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 8px;
  margin-top: 14px;
  padding-top: 12px;
  border-top: 1px dashed color-mix(in srgb, var(--line) 70%, transparent);
  font: 500 .68rem "JetBrains Mono", monospace;
  color: var(--muted);
  letter-spacing: .02em;
  text-align: center;
}
.provider-tier-foot svg{ width: 11px; height: 11px; opacity: .7; flex-shrink: 0; }
[data-theme='dark'] .provider-tier--extended{
  background:
    linear-gradient(180deg, color-mix(in srgb, var(--paper) 96%, transparent) 0%, color-mix(in srgb, var(--paper-2) 22%, transparent) 100%);
  border-color: color-mix(in srgb, var(--line) 46%, transparent);
  box-shadow:
    inset 0 1px 0 color-mix(in srgb, var(--paper) 8%, transparent),
    0 14px 32px -28px rgba(0,0,0,.35);
}

/* Tier header: clean horizontal rule with embedded label badge */
.tier-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  margin: 0 0 18px;
  padding-bottom: 12px;
  border-bottom: 1px solid color-mix(in srgb, var(--line) 80%, transparent);
}

/* Tier label with dot accent */
.tier-label {
  display: flex;
  align-items: center;
  gap: 9px;
}
.tier-label-dot {
  display: block;
  width: 6px;
  height: 6px;
  border-radius: 50%;
  flex-shrink: 0;
  background: var(--accent);
  box-shadow: 0 0 0 2px color-mix(in srgb, var(--accent) 18%, transparent);
}
.provider-tier--extended .tier-label-dot {
  background: var(--muted);
  box-shadow: 0 0 0 2px color-mix(in srgb, var(--line) 20%, transparent);
}
.tier-head h3 {
  font-family: "Space Grotesk", Inter, sans-serif;
  font-size: 1.0rem;
  margin: 0;
  color: var(--ink);
  font-weight: 800;
  letter-spacing:-.025em;
}
.tier-count{
  font: 700 .7rem "JetBrains Mono", monospace;
  letter-spacing:.08em;
  text-transform:uppercase;
  color: var(--accent);
  background: var(--accent-soft);
  border: 1px solid color-mix(in srgb, var(--accent) 18%, var(--line));
  padding: 6px 11px;
  border-radius: 999px;
  box-shadow:
    inset 0 1px 0 color-mix(in srgb, var(--paper) 80%, transparent),
    0 1px 2px rgba(15,23,42,.04);
}
.tier-count--muted{
  color: var(--muted);
  background: color-mix(in srgb, var(--paper-2) 86%, var(--paper));
  border-color: color-mix(in srgb, var(--line) 86%, transparent);
  box-shadow: inset 0 1px 0 color-mix(in srgb, var(--paper) 60%, transparent);
}

.provider-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0,1fr));
  gap: 14px;
  justify-content:center;
}
.provider-grid--extended{
  grid-template-columns: repeat(3, minmax(0, 220px));
  justify-content: center;
  gap: 12px;
}

.provider-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 13px;
  padding: 22px 16px 18px;
  border: 1px solid color-mix(in srgb, var(--line) 84%, transparent);
  border-radius: 22px;
  background: linear-gradient(180deg, var(--paper) 0%, color-mix(in srgb, var(--paper) 96%, var(--paper-2)) 100%);
  transition: transform .24s cubic-bezier(.22,1,.36,1), border-color .24s ease, box-shadow .24s ease, background .24s ease;
  position: relative;
  overflow: hidden;
  text-align:center;
  min-height: 162px;
  isolation:isolate;
  box-shadow:
    inset 0 1px 0 color-mix(in srgb, var(--paper) 86%, transparent);
}
.provider-item::before{
  content:"";
  position:absolute;
  left:0; right:0; top:0;
  height: 2px;
  background: linear-gradient(90deg, var(--cyan), var(--accent), var(--violet));
  background-size: 200% 100%;
  opacity:0;
  transition: opacity .24s ease;
  animation: logo-metallic 3.8s linear infinite;
}
.provider-item::after{
  content:"";
  position:absolute;
  inset:0;
  border-radius:inherit;
  background: radial-gradient(420px 220px at 50% 0%, color-mix(in srgb, var(--accent) 04%, transparent), transparent 62%);
  opacity:0;
  transition: opacity .24s ease;
  pointer-events:none;
}
.provider-item:hover{
  transform: translateY(-4px) scale(1.01);
  border-color: color-mix(in srgb, var(--accent) 18%, var(--line));
  box-shadow: 0 14px 32px rgba(15,23,42,.09), 0 2px 10px rgba(81,71,230,.08);
  background: linear-gradient(180deg, var(--paper) 0%, color-mix(in srgb, var(--paper-2) 18%, var(--paper)) 100%);
}
.provider-item:hover::before{ opacity:1; }
.provider-item:hover::after{ opacity:1; }
[data-theme='dark'] .provider-item:hover{
  background: linear-gradient(180deg, color-mix(in srgb, var(--paper-2) 72%, var(--paper)) 0%, color-mix(in srgb, var(--paper) 88%, transparent) 100%);
  border-color: color-mix(in srgb, var(--accent) 22%, var(--line));
  box-shadow:
    0 16px 36px rgba(0,0,0,.32),
    0 2px 12px rgba(81,71,230,.12),
    inset 0 1px 0 color-mix(in srgb, var(--paper) 22%, transparent);
}
.provider-item--extended{
  flex-direction: column;
  min-height: 138px;
  padding: 18px 14px 16px;
  justify-content: center;
  align-items: center;
  text-align: center;
  gap: 11px;
  border-radius: 10px;
  box-shadow: none;
  background: color-mix(in srgb, var(--paper) 92%, var(--paper-2));
  border-style: dashed;
  border-color: color-mix(in srgb, var(--line) 88%, transparent);
}
.provider-item--extended .provider-name{ text-align: center; }
.provider-item--extended .provider-meta{ text-align: center; }
.provider-item--extended:hover{
  border-style: solid;
  border-color: color-mix(in srgb, var(--accent) 14%, var(--line));
}

[data-theme='dark'] .provider-tier--first{
  background:
    radial-gradient(640px 320px at 50% 0%, color-mix(in srgb, var(--accent) 08%, transparent), transparent 70%),
    color-mix(in srgb, var(--paper-2) 58%, transparent);
  border-color: color-mix(in srgb, var(--line) 52%, transparent);
  box-shadow:
    inset 0 1px 0 color-mix(in srgb, var(--paper) 12%, transparent),
    0 18px 44px -22px rgba(0,0,0,.45);
}
[data-theme='dark'] .provider-item{
  background: linear-gradient(180deg, color-mix(in srgb, var(--paper-2) 44%, var(--paper)) 0%, color-mix(in srgb, var(--paper) 96%, transparent) 100%);
  border-color: color-mix(in srgb, var(--line) 54%, transparent);
  box-shadow:
    inset 0 1px 0 color-mix(in srgb, var(--paper) 18%, transparent),
    0 4px 16px rgba(0,0,0,.14);
}
[data-theme='dark'] .provider-item--extended{
  background: color-mix(in srgb, var(--paper-2) 30%, var(--paper));
  border-color: color-mix(in srgb, var(--line) 60%, transparent);
}

.provider-name {
  font-size: .88rem;
  font-weight: 800;
  color: var(--ink);
  text-align: center;
  letter-spacing: -0.018em;
  line-height:1.2;
}
.provider-meta{
  font: 500 .68rem "JetBrains Mono", monospace;
  color: var(--muted);
  letter-spacing:.01em;
  line-height:1.35;
  max-width: 100%;
  overflow:hidden;
  text-overflow:ellipsis;
  white-space:nowrap;
}
[data-theme='dark'] .provider-meta{ color: color-mix(in srgb, var(--muted) 92%, var(--ink) 8%); }

@media (max-width: 1100px){
  .provider-grid{ grid-template-columns: repeat(4, minmax(0,1fr)); }
  .provider-grid--extended{ grid-template-columns: repeat(3, minmax(0, 1fr)); }
}
@media (max-width: 860px){
  .provider-grid{ grid-template-columns: repeat(3, minmax(0,1fr)); }
  .provider-grid--extended{ grid-template-columns: repeat(3, minmax(0, 1fr)); }
}
@media (max-width: 720px) {
  .provider-grid { grid-template-columns: repeat(2, minmax(0,1fr)); gap: 10px; }
  .provider-grid--extended{ grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10px; }
  .provider-tier--first{ border-radius: 22px; padding: 22px 18px 20px; }
  .provider-tier--extended{ border-radius: 22px; padding: 20px 16px 18px; }
  .provider-item { padding: 20px 14px 18px; min-height: 148px; border-radius: 18px; }
  .provider-item--extended{ min-height: 122px; padding: 16px 12px 14px; border-radius: 10px; }
  .tier-head{ flex-direction:column; align-items:flex-start; gap:8px; }
}
@media (max-width: 560px){
  .provider-grid--extended{ grid-template-columns: 1fr; }
}
@media (max-width: 420px){
  .provider-grid{ grid-template-columns: repeat(2, minmax(0,1fr)); gap:10px; }
}
</style>
