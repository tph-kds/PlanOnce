---
const nodes = [
  { id: 'route', name: 'ROUTE', copy: 'Choose the smallest safe workflow', step: '01' },
  { id: 'freeze', name: 'FREEZE INTENT', copy: 'Fingerprint accepted intent', step: '02' },
  { id: 'execute', name: 'EXECUTE SAFELY', copy: 'Preserve scope and workspace', step: '03' },
  { id: 'prove', name: 'PROVE FRESHNESS', copy: 'Bind evidence to current revision', step: '04' },
  { id: 'review', name: 'REVIEW', copy: 'Human-readable readiness decision', step: '05' },
];
const failureRoutes = [
  {
    id: 'fix-reverify',
    label: 'FIX_REVERIFY',
    target: 'verification',
    sourceNode: 'prove',
    targetNode: 'prove',
    description: 'Defects re-enter the evidence step until evidence is fresh.',
    accent: 'violet',
  },
  {
    id: 'blocked-amend',
    label: 'BLOCKED_AMEND',
    target: 'human approval',
    sourceNode: 'execute',
    targetNode: 'freeze',
    description: 'Plan contradictions return to accepted intent for re-approval.',
    accent: 'cyan',
  },
];
---
<div class="reliability-loop reveal" aria-label="PlanOnce reliability control loop">
  <div class="reliability-loop-nodes" role="list">
    {nodes.map((node, index) => (
      <article
        class="reliability-node"
        data-node={node.id}
        data-step={node.step}
        style={`--i:${index}`}
        role="listitem"
      >
        <span class="reliability-node-step" aria-hidden="true">{node.step}</span>
        <h3>{node.name}</h3>
        <p>{node.copy}</p>
      </article>
    ))}
  </div>

  <svg
    class="reliability-loop-svg"
    viewBox="0 0 1080 360"
    role="img"
    aria-label="Route, freeze intent, execute safely, prove freshness, recover, review. Defects return to verification. Plan contradictions return to human approval."
    preserveAspectRatio="none"
  >
    <defs>
      <marker
        id="reliability-arrow"
        viewBox="0 0 10 10"
        refX="8"
        refY="5"
        markerWidth="6"
        markerHeight="6"
        orient="auto-start-reverse"
      >
        <path d="M 0 0 L 10 5 L 0 10 z" fill="currentColor" />
      </marker>
      <marker
        id="reliability-arrow-violet"
        viewBox="0 0 10 10"
        refX="8"
        refY="5"
        markerWidth="6"
        markerHeight="6"
        orient="auto-start-reverse"
      >
        <path d="M 0 0 L 10 5 L 0 10 z" fill="currentColor" />
      </marker>
      <marker
        id="reliability-arrow-cyan"
        viewBox="0 0 10 10"
        refX="8"
        refY="5"
        markerWidth="6"
        markerHeight="6"
        orient="auto-start-reverse"
      >
        <path d="M 0 0 L 10 5 L 0 10 z" fill="currentColor" />
      </marker>

      <!-- Gradient definitions for the flowing comet overlays -->
      <linearGradient id="flow-main" x1="0" y1="0" x2="1" y2="0">
        <stop offset="0%" class="flow-stop flow-stop--cyan" />
        <stop offset="14%" class="flow-stop flow-stop--cyan-mid" />
        <stop offset="50%" class="flow-stop flow-stop--accent" />
        <stop offset="86%" class="flow-stop flow-stop--violet-mid" />
        <stop offset="100%" class="flow-stop flow-stop--violet" />
      </linearGradient>
      <linearGradient id="flow-recover" x1="1" y1="0" x2="0" y2="0">
        <stop offset="0%" class="flow-stop flow-stop--accent-strong-end" />
        <stop offset="50%" class="flow-stop flow-stop--accent-strong" />
        <stop offset="100%" class="flow-stop flow-stop--accent-strong-end" />
      </linearGradient>
      <linearGradient id="flow-violet" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" class="flow-stop flow-stop--violet-end" />
        <stop offset="40%" class="flow-stop flow-stop--violet-mid-2" />
        <stop offset="100%" class="flow-stop flow-stop--violet-end" />
      </linearGradient>
      <linearGradient id="flow-cyan" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" class="flow-stop flow-stop--cyan-end" />
        <stop offset="40%" class="flow-stop flow-stop--cyan-mid-2" />
        <stop offset="100%" class="flow-stop flow-stop--cyan-end" />
      </linearGradient>

      <!-- Soft glow filter for the comet trails -->
      <filter id="flow-glow" x="-20%" y="-20%" width="140%" height="140%">
        <feGaussianBlur stdDeviation="2.2" result="blur" />
        <feMerge>
          <feMergeNode in="blur" />
          <feMergeNode in="SourceGraphic" />
        </feMerge>
      </filter>

      <!-- Execution pulse gradient — purple → blue → cyan, vertical fade -->
      <!-- Used on the connector overlay so a small "data packet" segment slides top → bottom -->
      <linearGradient id="exec-pulse-violet" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%"   class="flow-stop flow-stop--violet-end" />
        <stop offset="20%"  class="flow-stop flow-stop--violet-bright" />
        <stop offset="45%"  class="flow-stop flow-stop--accent-bright" />
        <stop offset="70%"  class="flow-stop flow-stop--cyan-bright" />
        <stop offset="100%" class="flow-stop flow-stop--cyan-end" />
      </linearGradient>
      <linearGradient id="exec-pulse-cyan" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%"   class="flow-stop flow-stop--violet-end" />
        <stop offset="20%"  class="flow-stop flow-stop--violet-bright" />
        <stop offset="45%"  class="flow-stop flow-stop--accent-bright" />
        <stop offset="70%"  class="flow-stop flow-stop--cyan-bright" />
        <stop offset="100%" class="flow-stop flow-stop--cyan-end" />
      </linearGradient>

      <!-- Shared vertical gradient for the two failure-route connector dashes.
           Both BLOCKED_AMEND (cyan, under EXECUTE/03) and FIX_REVERIFY (violet,
           under PROVE/04) carry this SAME gradient so the eye reads them as a
           single flowing river of signal instead of two separate accents.
           The phase offset between the two strokes (see --march-phase) is what
           makes them feel harmonious rather than identical. -->
      <linearGradient id="connector-flow" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%"   class="flow-stop flow-stop--violet-end" />
        <stop offset="14%"  class="flow-stop flow-stop--violet-bright" />
        <stop offset="38%"  class="flow-stop flow-stop--accent-bright" />
        <stop offset="62%"  class="flow-stop flow-stop--accent-bright" />
        <stop offset="86%"  class="flow-stop flow-stop--cyan-bright" />
        <stop offset="100%" class="flow-stop flow-stop--cyan-end" />
      </linearGradient>

      <!-- Multi-hue connector gradient.
           Used by the base connector stroke, the comet overlay, and the
           scan-beam. All three layers reference this same gradient so
           the eye reads a single consistent violet→accent→cyan→violet
           ramp on each connector.

           Note on the "flowing" gradient effect:
           We deliberately do NOT animate this gradient's transform via
           SMIL <animateTransform>. In Chrome, gradientTransform changes
           triggered by SMIL are not always honored, which left the
           previous animated gradient visually static (showing only the
           violet end of the ramp on short connectors). Instead, the
           downward-flow feeling is achieved entirely through CSS
           stroke-dashoffset animations (connector-march, flow-connector-*)
           layered on top of this static gradient. Those animations run
           reliably in every modern browser. -->
      <linearGradient
        id="connector-flow-animated"
        x1="0"
        y1="0"
        x2="0"
        y2="1"
        gradientUnits="objectBoundingBox"
      >
        <!-- Each stop's stop-color cycles through the design-system palette
             over 4.8s, creating the appearance of a flowing river of color.
             This animates the actual stop values (not the gradient
             transform), which is reliably honored by Chrome, Safari, and
             Firefox. The hex values are the dark-theme tokens (--violet,
             --accent, --cyan) so the gradient reads on both light and
             dark backgrounds. -->
        <stop offset="0%" stop-color="#a77bff">
          <animate attributeName="stop-color"
            values="#a77bff;#22d3ee;#22d3ee;#a77bff"
            keyTimes="0;0.4;0.6;1"
            dur="4.8s" repeatCount="indefinite" />
        </stop>
        <stop offset="30%" stop-color="#7775ff">
          <animate attributeName="stop-color"
            values="#7775ff;#a77bff;#22d3ee;#7775ff"
            keyTimes="0;0.4;0.6;1"
            dur="4.8s" repeatCount="indefinite" />
        </stop>
        <stop offset="65%" stop-color="#22d3ee">
          <animate attributeName="stop-color"
            values="#22d3ee;#7775ff;#a77bff;#22d3ee"
            keyTimes="0;0.4;0.6;1"
            dur="4.8s" repeatCount="indefinite" />
        </stop>
        <stop offset="100%" stop-color="#22d3ee">
          <animate attributeName="stop-color"
            values="#22d3ee;#a77bff;#7775ff;#22d3ee"
            keyTimes="0;0.4;0.6;1"
            dur="4.8s" repeatCount="indefinite" />
        </stop>
      </linearGradient>

      <!-- Horizontal segment gradient — purple → blue → cyan, used as the
           base stroke for each horizontal segment between stage cards. -->
      <linearGradient id="h-segment-flow" x1="0" y1="0" x2="1" y2="0">
        <stop offset="0%"   class="flow-stop flow-stop--violet-end" />
        <stop offset="20%"  class="flow-stop flow-stop--violet-bright" />
        <stop offset="50%"  class="flow-stop flow-stop--accent-bright" />
        <stop offset="80%"  class="flow-stop flow-stop--cyan-bright" />
        <stop offset="100%" class="flow-stop flow-stop--cyan-end" />
      </linearGradient>

      <!-- Sharper glow filter for the execution pulse (smaller blur for a more "technical" feel) -->
      <filter id="exec-pulse-glow" x="-30%" y="-30%" width="160%" height="160%">
        <feGaussianBlur stdDeviation="1.4" result="blur" />
        <feMerge>
          <feMergeNode in="blur" />
          <feMergeNode in="SourceGraphic" />
        </feMerge>
      </filter>
    </defs>

    <!-- Horizontal connector segments — broken into 4 individual paths so each
         can carry its own gradient, dash march, and comet flow.
         Position: between adjacent stage cards. -->
    <path
      class="reliability-h-segment reliability-h-segment--1"
      data-h-segment="1"
      pathLength="100"
      d="M120 60 H330"
    />
    <path
      class="reliability-h-segment reliability-h-segment--2"
      data-h-segment="2"
      pathLength="100"
      d="M330 60 H540"
    />
    <path
      class="reliability-h-segment reliability-h-segment--3"
      data-h-segment="3"
      pathLength="100"
      d="M540 60 H750"
    />
    <path
      class="reliability-h-segment reliability-h-segment--4"
      data-h-segment="4"
      pathLength="100"
      d="M750 60 H960"
      marker-end="url(#reliability-arrow)"
    />

    <!-- Main forward path: ROUTE → FREEZE → EXECUTE → PROVE → REVIEW
         (kept as a hidden single-line reference for layout; the visual
         connector is now the 4 segments above) -->
    <path
      class="reliability-loop-path reliability-loop-path--main"
      data-reliability-path
      pathLength="100"
      d="M120 60 H960"
      aria-hidden="true"
    />

    <!-- Recover path: REVIEW wraps back to ROUTE (closes the loop) -->
    <path
      class="reliability-loop-path reliability-loop-path--recover"
      data-reliability-path
      pathLength="100"
      d="M960 60 C 1020 60, 1020 320, 960 320 L 120 320 C 60 320, 60 60, 120 60"
      marker-end="url(#reliability-arrow)"
    />

    <!-- FIX_REVERIFY: drops down from PROVE FRESHNESS, returns to PROVE FRESHNESS (re-prove loop) -->
    <path
      class="reliability-loop-path reliability-loop-path--failure reliability-loop-path--violet"
      data-failure-route="fix-reverify"
      pathLength="100"
      d="M750 60 V 200 C 750 230, 750 240, 750 240"
      marker-end="url(#reliability-arrow-violet)"
    />

    <!-- BLOCKED_AMEND: drops down from EXECUTE, returns to FREEZE INTENT (re-route loop) -->
    <path
      class="reliability-loop-path reliability-loop-path--failure reliability-loop-path--cyan"
      data-failure-route="blocked-amend"
      pathLength="100"
      d="M330 60 V 270 C 330 290, 330 290, 330 290"
      marker-end="url(#reliability-arrow-cyan)"
    />

    <!-- ───────────────────────────────────────────────────────────────── -->
    <!-- Connector dashes — short animated paths linking each failure-     -->
    <!-- route path endpoint to its card. Visible "live" connector.        -->
    <!-- ───────────────────────────────────────────────────────────────── -->
    <g class="reliability-connectors" aria-hidden="true">
      <!-- Connector for FIX_REVERIFY: from PROVE FRESHNESS column down to the violet card -->
      <path
        class="reliability-connector reliability-connector--violet"
        data-connector="fix-reverify"
        pathLength="100"
        d="M750 240 V 320"
        filter="url(#flow-glow)"
      />
      <!-- Connector for BLOCKED_AMEND: from EXECUTE column down to the cyan card -->
      <path
        class="reliability-connector reliability-connector--cyan"
        data-connector="blocked-amend"
        pathLength="100"
        d="M330 290 V 340"
        filter="url(#flow-glow)"
      />
    </g>

    <!-- ───────────────────────────────────────────────────────────────── -->
    <!-- Flowing comet overlays — animated stroke-dashoffset per path       -->
    <!-- ───────────────────────────────────────────────────────────────── -->
    <g class="reliability-flow" aria-hidden="true">
      <!-- Forward flow (cyan → accent → violet), left → right -->
      <path
        class="reliability-flow-path reliability-flow-path--main"
        pathLength="100"
        d="M120 60 H960"
        filter="url(#flow-glow)"
      />
      <!-- Recover flow (muted accent), right → left (wraps back) -->
      <path
        class="reliability-flow-path reliability-flow-path--recover"
        pathLength="100"
        d="M960 60 C 1020 60, 1020 320, 960 320 L 120 320 C 60 320, 60 60, 120 60"
        filter="url(#flow-glow)"
      />
      <!-- FIX_REVERIFY flow (violet), drops and returns -->
      <path
        class="reliability-flow-path reliability-flow-path--violet"
        pathLength="100"
        d="M750 60 V 200 C 750 230, 750 240, 750 240"
        filter="url(#flow-glow)"
      />
      <!-- BLOCKED_AMEND flow (cyan), drops deeper, returns further -->
      <path
        class="reliability-flow-path reliability-flow-path--cyan"
        pathLength="100"
        d="M330 60 V 270 C 330 290, 330 290, 330 290"
        filter="url(#flow-glow)"
      />
      <!-- Connector dash for FIX_REVERIFY (violet, runs down to card) -->
      <path
        class="reliability-flow-path reliability-flow-path--connector-violet"
        pathLength="100"
        d="M750 240 V 320"
        filter="url(#flow-glow)"
      />
      <!-- Connector dash for BLOCKED_AMEND (cyan, runs down to card) -->
      <path
        class="reliability-flow-path reliability-flow-path--connector-cyan"
        pathLength="100"
        d="M330 290 V 340"
        filter="url(#flow-glow)"
      />
      <!-- ─────────────────────────────────────────────────────────────── -->
      <!-- Execution pulse — small purple→blue→cyan segment sliding         -->
      <!-- top-to-bottom along each vertical connector. Sequential         -->
      <!-- activation of source nodes and target cards.                    -->
      <!-- ─────────────────────────────────────────────────────────────── -->
      <path
        class="exec-pulse exec-pulse--violet"
        pathLength="100"
        d="M750 240 V 320"
        filter="url(#exec-pulse-glow)"
        aria-hidden="true"
      />
      <path
        class="exec-pulse exec-pulse--cyan"
        pathLength="100"
        d="M330 290 V 340"
        filter="url(#exec-pulse-glow)"
        aria-hidden="true"
      />
      <!-- ─────────────────────────────────────────────────────────────── -->
      <!-- Scanning beam — wider, brighter overlay that sweeps down         -->
      <!-- continuously. This is the "always-on" data flow signal.         -->
      <!-- ─────────────────────────────────────────────────────────────── -->
      <path
        class="scan-beam scan-beam--violet"
        pathLength="100"
        d="M750 240 V 320"
        filter="url(#flow-glow)"
        aria-hidden="true"
      />
      <path
        class="scan-beam scan-beam--cyan"
        pathLength="100"
        d="M330 290 V 340"
        filter="url(#flow-glow)"
        aria-hidden="true"
      />
      <!-- ─────────────────────────────────────────────────────────────── -->
      <!-- Horizontal segment comets — bright gradient packet sliding      -->
      <!-- left → right along each horizontal connector between cards.    -->
      <!-- ─────────────────────────────────────────────────────────────── -->
      <path
        class="h-segment-comet h-segment-comet--1"
        pathLength="100"
        d="M120 60 H330"
        filter="url(#flow-glow)"
        aria-hidden="true"
      />
      <path
        class="h-segment-comet h-segment-comet--2"
        pathLength="100"
        d="M330 60 H540"
        filter="url(#flow-glow)"
        aria-hidden="true"
      />
      <path
        class="h-segment-comet h-segment-comet--3"
        pathLength="100"
        d="M540 60 H750"
        filter="url(#flow-glow)"
        aria-hidden="true"
      />
      <path
        class="h-segment-comet h-segment-comet--4"
        pathLength="100"
        d="M750 60 H960"
        filter="url(#flow-glow)"
        aria-hidden="true"
      />
    </g>

    <!-- Endpoint dots removed per design spec -->
  </svg>

  <!-- Failure-route labels positioned via CSS variables relative to their source node -->
  <div class="failure-routes" aria-label="Failure recovery routes">
    {failureRoutes.map((route) => (
      <div
        class="failure-route"
        data-failure-route={route.id}
        data-source-node={route.sourceNode}
        data-target-node={route.targetNode}
      >
        <div class="failure-route-line" aria-hidden="true"></div>
        <div class="failure-route-pill">
          <span class={`failure-route-accent failure-route-accent--${route.accent}`} aria-hidden="true"></span>
          <strong>{route.label}</strong>
          <i aria-hidden="true">→</i>
          <span class="failure-route-target">{route.target}</span>
        </div>
        <p class="failure-route-description">{route.description}</p>
      </div>
    ))}
  </div>

  <footer class="reliability-loop-foot" aria-label="Loop summary">
    <span><strong>5</strong> forward steps</span>
    <span class="reliability-loop-foot-divider" aria-hidden="true"></span>
    <span><strong>2</strong> recovery routes</span>
    <span class="reliability-loop-foot-divider" aria-hidden="true"></span>
    <span><strong>1</strong> human gate</span>
    <span class="reliability-loop-foot-divider" aria-hidden="true"></span>
    <span class="reliability-loop-foot-recover"><strong>RECOVER</strong> closes the loop</span>
  </footer>
</div>
<script>
  /**
   * Responsive connector alignment.
   * Recalculates vertical connector X coordinates based on the actual
   * DOM positions of source nodes and target cards whenever the window
   * resizes, keeping the dashed lines pixel-aligned to element centers.
   */
  (function () {
    const SVG_NS = 'http://www.w3.org/2000/svg';
    const VB_W   = 1080;   // viewBox width
    const VB_H   = 360;    // viewBox height
    const VB_TOP = 60;     // y of node row in viewBox space

    /** All paths whose d attribute needs an X update. */
    const SELECTORS = [
      // Main failure curves (drop from node row)
      '[data-failure-route="fix-reverify"]',
      '[data-failure-route="blocked-amend"]',
      // Connector dashes (vertical line to card)
      '[data-connector="fix-reverify"]',
      '[data-connector="blocked-amend"]',
      // Flow overlays
      '.reliability-flow-path--violet',
      '.reliability-flow-path--cyan',
      '.reliability-flow-path--connector-violet',
      '.reliability-flow-path--connector-cyan',
      // Execution pulse
      '.exec-pulse--violet',
      '.exec-pulse--cyan',
      // Scan beam
      '.scan-beam--violet',
      '.scan-beam--cyan',
    ];

    /**
     * Convert a DOM rect's center (in page pixels) to SVG viewBox
     * coordinates, accounting for the SVG's inset positioning and
     * current bounding-box width/height.
     */
    function domToSvg(elt) {
      const svg    = document.querySelector('.reliability-loop-svg');
      const svgBox = svg.getBoundingClientRect();
      // Account for the SVG's inset: 30px on each side
      const inset  = 30;
      const svgX   = (elt.getBoundingClientRect().left + elt.getBoundingClientRect().width  / 2 - svgBox.left - inset) / (svgBox.width  - inset * 2) * VB_W;
      const svgY   = (elt.getBoundingClientRect().top  + elt.getBoundingClientRect().height / 2 - svgBox.top  - inset) / (svgBox.height - inset * 2) * VB_H;
      return { x: Math.round(svgX), y: Math.round(svgY) };
    }

    function updateConnectors() {
      const svg = document.querySelector('.reliability-loop-svg');
      if (!svg) return;

      const fixNode  = document.querySelector('[data-node="prove"]');   // step 04
      const blockNode = document.querySelector('[data-node="freeze"]');  // step 02
      const fixCard  = document.querySelector('[data-failure-route="fix-reverify"]');
      const blockCard = document.querySelector('[data-failure-route="blocked-amend"]');
      if (!fixNode || !blockNode || !fixCard || !blockCard) return;

      const fixSvgTop  = domToSvg(fixNode);
      const blockSvgTop = domToSvg(blockNode);
      const fixSvgCard  = domToSvg(fixCard);
      const blockSvgCard = domToSvg(blockCard);

      // Vertical connector X: start = node center, end = card top-center
      const fixX   = fixSvgTop.x;
      const blockX = blockSvgTop.x;
      const fixEndY   = fixSvgCard.y;
      const blockEndY = blockSvgCard.y;

      const fixPaths   = svg.querySelectorAll(SELECTORS.join(','));
      fixPaths.forEach(p => {
        const isFix = p.matches('[data-failure-route="fix-reverify"], [data-connector="fix-reverify"], .exec-pulse--violet, .scan-beam--violet, .reliability-flow-path--violet, .reliability-flow-path--connector-violet');
        if (isFix) {
          const endY = fixEndY;
          p.setAttribute('d',
            p.classList.contains('reliability-loop-path--failure')
              ? `M${fixX} ${VB_TOP} V 200 C ${fixX} 230, ${fixX} 240, ${fixX} 240`
              : `M${fixX} 240 V ${endY}`
          );
        } else {
          const endY = blockEndY;
          p.setAttribute('d',
            p.classList.contains('reliability-loop-path--failure')
              ? `M${blockX} ${VB_TOP} V 270 C ${blockX} 290, ${blockX} 290, ${blockX} 290`
              : `M${blockX} 290 V ${endY}`
          );
        }
      });
    }

    // Run once on load
    updateConnectors();
    // Re-run whenever the container resizes
    const ro = new ResizeObserver(() => updateConnectors());
    const container = document.querySelector('.reliability-loop');
    if (container) ro.observe(container);
    window.addEventListener('resize', updateConnectors, { passive: true });
  })();
</script>
<style>
.reliability-loop {
  position: relative;
  min-height: 460px;
  border: 1px solid color-mix(in srgb, var(--line) 78%, transparent);
  border-radius: var(--radius-lg);
  background:
    radial-gradient(820px 520px at 50% 0%, color-mix(in srgb, var(--accent) 04%, transparent), transparent 68%),
    linear-gradient(180deg, color-mix(in srgb, var(--paper-2) 38%, var(--paper)), var(--paper));
  overflow: hidden;
  isolation: isolate;
  padding: 30px 30px 28px;
}
.reliability-loop::before {
  content: "";
  position: absolute;
  inset: -1px;
  border-radius: inherit;
  padding: 1px;
  background: linear-gradient(110deg, var(--cyan), var(--accent), var(--violet));
  background-size: 200% 100%;
  -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
  -webkit-mask-composite: xor;
  mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
  mask-composite: exclude;
  opacity: 0;
  transition: opacity .22s ease;
  animation: logo-metallic 5s linear infinite;
  pointer-events: none;
}
.reliability-loop:hover::before { opacity: .6; }
[data-theme='dark'] .reliability-loop {
  background:
    radial-gradient(820px 520px at 50% 0%, color-mix(in srgb, var(--violet) 08%, transparent), transparent 68%),
    radial-gradient(640px 380px at 90% 100%, color-mix(in srgb, var(--cyan) 06%, transparent), transparent 64%),
    linear-gradient(180deg, color-mix(in srgb, var(--paper-2) 32%, var(--paper)), color-mix(in srgb, var(--paper) 96%, transparent));
  border-color: color-mix(in srgb, var(--line) 52%, transparent);
}

/* SVG path layer */
.reliability-loop-svg {
  position: absolute;
  inset: 30px;
  width: calc(100% - 60px);
  height: calc(100% - 60px);
  pointer-events: none;
  z-index: 0;
}
.reliability-loop-svg path {
  fill: none;
  stroke-width: 1.5;
  stroke-linecap: round;
  stroke-linejoin: round;
}
.reliability-loop-path--main {
  /* Now visually replaced by the 4 horizontal segments. Kept for
     semantic continuity (data-reliability-path attribute); rendered
     invisibly. The 4 .reliability-h-segment paths handle the visual. */
  stroke: transparent;
  stroke-width: 0;
  fill: none;
}
.reliability-loop-path--recover {
  stroke: color-mix(in srgb, var(--line) 78%, transparent);
  stroke-dasharray: 4 6;
  stroke-width: 1.5;
  color: color-mix(in srgb, var(--muted) 80%, transparent);
}
.reliability-loop-path--failure {
  stroke-width: 1.75;
}
.reliability-loop-path--violet {
  stroke: color-mix(in srgb, var(--violet) 64%, var(--line));
  stroke-dasharray: 5 5;
  color: color-mix(in srgb, var(--violet) 64%, var(--line));
}
.reliability-loop-path--cyan {
  stroke: color-mix(in srgb, var(--cyan) 64%, var(--line));
  stroke-dasharray: 5 5;
  color: color-mix(in srgb, var(--cyan) 64%, var(--line));
}
/* Flowing dash animation on the upper failure-route curves
   (the V/C paths that drop from the node row down to the connector
   dashes). Dashes slide top→bottom continuously.
   dasharray "5 5" → period 10; offset delta -20 = two periods (2.0s)
   is seamless. GPU-accelerated via the standard stroke-dashoffset
   property. */
@media (prefers-reduced-motion: no-preference) {
  .reliability-loop-path--violet {
    animation: failure-curve-flow 2.0s linear infinite;
    will-change: stroke-dashoffset;
  }
  .reliability-loop-path--cyan {
    animation: failure-curve-flow 2.0s linear infinite;
    animation-delay: -1s; /* half-period → alternating cadence */
    will-change: stroke-dashoffset;
  }
}
/* Loop dots removed — clean connector layout. */
[data-theme='dark'] .reliability-loop-path--main {
  stroke: color-mix(in srgb, var(--accent) 70%, var(--line));
  color: color-mix(in srgb, var(--accent) 70%, var(--line));
}
[data-theme='dark'] .reliability-loop-path--recover {
  stroke: color-mix(in srgb, var(--line) 70%, transparent);
  color: color-mix(in srgb, var(--line) 80%, transparent);
}
[data-theme='dark'] .reliability-loop-path--violet {
  stroke: color-mix(in srgb, var(--violet) 78%, var(--line));
  color: color-mix(in srgb, var(--violet) 78%, var(--line));
}
[data-theme='dark'] .reliability-loop-path--cyan {
  stroke: color-mix(in srgb, var(--cyan) 72%, var(--line));
  color: color-mix(in srgb, var(--cyan) 72%, var(--line));
}

/* ---------------------------------------------------------------- */
/* Flowing comet overlays — gradient stroke that runs along each    */
/* path, with stroke-dashoffset animation creating a moving trail.   */
/* ---------------------------------------------------------------- */
.reliability-flow {
  /* Container group; no styling beyond letting children inherit. */
}
.reliability-flow-path {
  fill: none;
  stroke-linecap: round;
  stroke-linejoin: round;
  stroke-width: 2.5;
  stroke-dasharray: 22 78; /* 22% bright comet + 78% gap (pathLength normalized to 100) */
  opacity: 0;
  will-change: stroke-dashoffset, opacity;
}
.reliability-flow-path--main {
  stroke: url(#flow-main);
  animation: flow-main 4.6s cubic-bezier(.55, 0, .45, 1) infinite;
}
.reliability-flow-path--recover {
  stroke: url(#flow-recover);
  stroke-dasharray: 14 86;
  animation: flow-recover 6.2s ease-in-out infinite;
}
.reliability-flow-path--violet {
  stroke: url(#flow-violet);
  stroke-dasharray: 26 74;
  animation: flow-violet 2.8s ease-in-out infinite;
}
.reliability-flow-path--cyan {
  stroke: url(#flow-cyan);
  stroke-dasharray: 22 78;
  animation: flow-cyan 3.4s cubic-bezier(.45, .05, .55, .95) infinite;
}

/* Gradient stop colors via CSS so they can use design tokens */
.flow-stop--cyan { stop-color: var(--cyan); stop-opacity: 0; }
.flow-stop--cyan-mid { stop-color: var(--cyan); stop-opacity: .55; }
.flow-stop--accent { stop-color: var(--accent); stop-opacity: 1; }
.flow-stop--violet-mid { stop-color: var(--violet); stop-opacity: .55; }
.flow-stop--violet { stop-color: var(--violet); stop-opacity: 0; }
.flow-stop--accent-strong { stop-color: var(--accent-strong); stop-opacity: .9; }
.flow-stop--accent-strong-end { stop-color: var(--accent-strong); stop-opacity: 0; }
.flow-stop--violet-end { stop-color: var(--violet); stop-opacity: 0; }
.flow-stop--violet-mid-2 { stop-color: var(--violet); stop-opacity: 1; }
.flow-stop--cyan-end { stop-color: var(--cyan); stop-opacity: 0; }
.flow-stop--cyan-mid-2 { stop-color: var(--cyan); stop-opacity: 1; }
/* Brighter stops for the execution pulse — full saturation so the small segment reads clearly */
.flow-stop--violet-bright { stop-color: var(--violet); stop-opacity: 1; }
.flow-stop--accent-bright { stop-color: var(--accent); stop-opacity: 1; }
.flow-stop--cyan-bright { stop-color: var(--cyan); stop-opacity: 1; }

/* Fade-in once revealed (a touch slower than the loop so it eases in) */
.reliability-loop[data-visible='true'] .reliability-flow-path--main { animation-delay: .15s; opacity: 1; }
.reliability-loop[data-visible='true'] .reliability-flow-path--recover { animation-delay: .8s; opacity: 1; }
.reliability-loop[data-visible='true'] .reliability-flow-path--violet { animation-delay: 1.2s; opacity: 1; }
.reliability-loop[data-visible='true'] .reliability-flow-path--cyan { animation-delay: .45s; opacity: 1; }

/* Endpoint dots removed per design spec — connector lines stand alone. */

/* ----------------------------------------------------------------- */
/* Connector dashes — short animated paths from each failure-path    */
/* endpoint down to its card. Visible "live" connection between the   */
/* SVG flow path and the failure-route card.                          */
/*                                                                     */
/* Both connectors share ONE gradient (connector-flow) and ONE dash    */
/* pattern, and march on the same 2.4s period. The cyan stroke is      */
/* phase-offset by half a period so the two dashes read as one         */
/* alternating rhythm rather than two competing animations.            */
/* ----------------------------------------------------------------- */
.reliability-connector {
  fill: none;
  stroke-linecap: round;
  stroke-width: 2;
  stroke-dasharray: 4 6;       /* period = 10 */
  opacity: 0.95;
  transition: stroke-width .22s ease, opacity .22s ease;
}
/* Shared gradient stroke — the same purple→blue→cyan river runs
   down both columns, so the eye reads them as one flowing gradient.
   The animated variant (`connector-flow-animated`) uses an SVG SMIL
   `animateTransform` to translate the gradient downward continuously,
   so the colors themselves appear to flow from top to bottom — not
   just the dashes marching over a static ramp. Reduced-motion users
   fall back to the static `connector-flow` (see the override below). */
.reliability-connector--violet,
.reliability-connector--cyan {
  stroke: url(#connector-flow-animated);
  /* Single, clean animation declaration. The march animation slides the
     dash pattern downward. With dasharray "4 6" (period 10), the offset
     delta of -10 is exactly one period → seamless loop. */
  will-change: stroke-dashoffset, stroke-width, opacity;
}
/* Dashes flow top→bottom on each connector. Wrapped in
   prefers-reduced-motion: no-preference so reduced-motion users see a
   static dashed line. The animation is fast enough (1.5s) that the flow
   reads as "data moving" rather than "decoration sliding". */
@media (prefers-reduced-motion: no-preference) {
  .reliability-connector--violet {
    animation: connector-march 1.5s linear infinite;
  }
  .reliability-connector--cyan {
    animation: connector-march 1.5s linear infinite;
    animation-delay: -0.75s; /* half-period → alternating cadence */
  }
}

/* Connector flow overlay — a brighter, shorter "comet" sliding DOWN the
   connector. Reuses the same animated purple→blue→cyan river as the base
   connector so all three layers (base dashes, comet overlay, exec pulse)
   read as a single flowing gradient. Dasharray is short so the base
   dashed gradient underneath shows through between comet passes. */
.reliability-flow-path--connector-violet,
.reliability-flow-path--connector-cyan {
  stroke: url(#connector-flow-animated);
  stroke-width: 5.5;          /* larger, more visible packet */
  stroke-dasharray: 28 72;     /* slightly longer bright segment */
  stroke-linecap: round;
  opacity: 1;                 /* visible immediately */
  will-change: stroke-dashoffset, opacity;
}
@media (prefers-reduced-motion: no-preference) {
  .reliability-flow-path--connector-violet {
    animation: flow-connector-violet 2.4s linear infinite;
  }
  .reliability-flow-path--connector-cyan {
    animation: flow-connector-cyan 2.4s linear infinite;
    animation-delay: -1.2s; /* half-period → alternating cadence */
  }
}

/* ----------------------------------------------------------------- */
/* Scanning beam — narrower overlay that sweeps down.                  */
/* Thinner than the base connector so the base flowing gradient shows  */
/* through between sweeps. The beam provides a moving highlight, not   */
/* the dominant color.                                                */
/* ----------------------------------------------------------------- */
.scan-beam {
  fill: none;
  stroke-linecap: round;
  stroke-linejoin: round;
  stroke-width: 2.5;
  stroke-dasharray: 22 78; /* 22% bright leading edge, 78% gap */
  opacity: 0.55;
  will-change: stroke-dashoffset, opacity;
}
.scan-beam--violet { stroke: url(#connector-flow-animated); animation-delay: 1.6s; }
.scan-beam--cyan   { stroke: url(#connector-flow-animated); animation-delay: -.6s; }
.scan-beam {
  opacity: 0.55;             /* always visible, layer on top of connector */
  animation: scan-beam-travel 4.4s cubic-bezier(.55, 0, .45, 1) infinite;
  will-change: stroke-dashoffset, opacity;
}

/* Connector endpoint tips removed — clean dashed connector lines. */

/* ----------------------------------------------------------------- */
/* Horizontal connector segments — 4 dashed gradient paths between    */
/* adjacent stage cards. Each segment has running dashes, gradient    */
/* stroke (purple → blue → cyan), a comet overlay, and endpoint tips. */
/* ----------------------------------------------------------------- */
.reliability-h-segment {
  fill: none;
  stroke-linecap: round;
  stroke-linejoin: round;
  stroke-width: 2;
  stroke-dasharray: 5 6; /* running dashes: 5 visible, 6 gap */
  opacity: 0;
  will-change: stroke-dashoffset, opacity;
}
.reliability-h-segment--1,
.reliability-h-segment--2,
.reliability-h-segment--3,
.reliability-h-segment--4 {
  stroke: url(#h-segment-flow);
}

/* Sequential activation: each segment fades in with a staggered delay
   so the forward-flow story reads left → right. After activation, the
   dashes continuously slide via the running-dash animation. */
.reliability-loop[data-visible='true'] .reliability-h-segment {
  opacity: .85;
  animation: h-segment-march 1.2s linear infinite;
}
.reliability-loop[data-visible='true'] .reliability-h-segment--1 {
  animation-delay: 0s, .2s;
}
.reliability-loop[data-visible='true'] .reliability-h-segment--2 {
  animation-delay: 0s, .55s;
}
.reliability-loop[data-visible='true'] .reliability-h-segment--3 {
  animation-delay: 0s, .9s;
}
.reliability-loop[data-visible='true'] .reliability-h-segment--4 {
  animation-delay: 0s, 1.25s;
}

/* Comet overlay on each horizontal segment — bright gradient packet sliding
   left → right with the full purple → blue → cyan horizontal gradient. */
.h-segment-comet {
  fill: none;
  stroke-linecap: round;
  stroke-linejoin: round;
  stroke-width: 4;
  stroke-dasharray: 30 55; /* wider packet, shorter gap = smoother flow */
  opacity: 0.92;
  will-change: stroke-dashoffset, opacity;
}
.h-segment-comet--1,
.h-segment-comet--2,
.h-segment-comet--3,
.h-segment-comet--4 {
  stroke: url(#h-segment-flow);
}
.reliability-loop[data-visible='true'] .h-segment-comet {
  animation: h-segment-comet-travel 3.2s cubic-bezier(.55, 0, .45, 1) infinite;
}
/* Staggered timing: comet1 leads, then 2/3/4 ripple through, then back to 1 */
.reliability-loop[data-visible='true'] .h-segment-comet--1 { animation-delay: 0s; }
.reliability-loop[data-visible='true'] .h-segment-comet--2 { animation-delay: .3s; }
.reliability-loop[data-visible='true'] .h-segment-comet--3 { animation-delay: .6s; }
.reliability-loop[data-visible='true'] .h-segment-comet--4 { animation-delay: .9s; }

/* Keyframes — each path animates stroke-dashoffset from 0 to -100
   (or +100 to 0 for the recover path which flows right-to-left) */
@keyframes flow-main {
  0%   { stroke-dashoffset: 100; }
  100% { stroke-dashoffset: -22; }
}
@keyframes flow-recover {
  0%   { stroke-dashoffset: 14; }
  100% { stroke-dashoffset: -100; }
}
@keyframes flow-violet {
  0%   { stroke-dashoffset: 100; }
  100% { stroke-dashoffset: -26; }
}
@keyframes flow-cyan {
  0%   { stroke-dashoffset: 100; }
  100% { stroke-dashoffset: -22; }
}
/* Failure-curve flow — slides the dash pattern top→bottom on the
   upper failure-route curves (the V/C paths from the node row down
   to the connector dashes). dasharray "5 5" → period 10. Offset
   delta of -20 = two full periods = seamless loop at 2.0s. */
@keyframes failure-curve-flow {
  0%   { stroke-dashoffset: 0; }
  100% { stroke-dashoffset: -20; }
}
@keyframes flow-pulse-start {
  0%, 100% { opacity: .55; transform: scale(1); }
  20%      { opacity: 1; transform: scale(1.4); }
  40%      { opacity: .55; transform: scale(1); }
}
@keyframes flow-pulse-end {
  0%, 100% { opacity: .55; transform: scale(1); }
  80%      { opacity: 1; transform: scale(1.4); }
  95%      { opacity: .55; transform: scale(1); }
}
@keyframes flow-pulse-violet-end {
  0%, 70%, 100% { opacity: 0; transform: scale(.6); }
  85%           { opacity: 1; transform: scale(1.8); }
  92%           { opacity: .55; transform: scale(1.2); }
}
@keyframes flow-pulse-cyan-end {
  0%, 70%, 100% { opacity: 0; transform: scale(.6); }
  85%           { opacity: 1; transform: scale(1.8); }
  92%           { opacity: .55; transform: scale(1.2); }
}
/* Running-dash animation — slides the dash pattern downward.
   The dashes literally travel along the line, like data flowing through a wire.
   pathLength is normalized to 100, and the dasharray is 4 6 (period = 10).
   Animating dashoffset from 0 to -10 = one full dash period, so the loop is seamless.
   Negative offset = dashes move WITH the path direction = downward (top → bottom). */
@keyframes connector-march {
  0%   { stroke-dashoffset: 0; }
  100% { stroke-dashoffset: -10; }
}
/* Horizontal segment running-dash — dashes slide left → right.
   pathLength=100, dasharray=5 6 (period=11), so dashoffset -11 = one period. */
@keyframes h-segment-march {
  0%   { stroke-dashoffset: 0; }
  100% { stroke-dashoffset: -11; }
}
/* Horizontal segment comet — bright packet slides left → right.
   Larger dasharray (30/55) creates a longer "leading edge" than the
   running dashes. Animates the offset by one full period (85) so the
   loop is perfectly seamless. */
@keyframes h-segment-comet-travel {
  0%   { stroke-dashoffset: 85; opacity: 0; }
  8%   { opacity: .9; }
  92%  { opacity: .9; }
  100% { stroke-dashoffset: 0; opacity: 0; }
}
/* Scanning beam — wider, brighter overlay that continuously sweeps down.
   Larger dasharray (38/62) makes a longer "comet head", with a brief fade-out
   between sweeps so it doesn't feel mechanical. */
/* Scanning beam — narrower overlay sweeps down continuously.
   Dasharray 22 78 → period 100; animating offset 100 → 0 = one full
   seamless period. Fades in briefly, holds, then fades out before reset. */
@keyframes scan-beam-travel {
  0%   { stroke-dashoffset: 100; opacity: 0; }
  6%   { opacity: .55; }
  70%  { stroke-dashoffset: 22; opacity: .55; }
  85%  { opacity: 0; stroke-dashoffset: 22; }
  100% { opacity: 0; stroke-dashoffset: 100; }
}
/* Connector comet — bright short packet sliding DOWN the connector on
   top of the base dashed gradient. Dasharray 24 76 → period 100;
   animating offset 100 → 0 = one full seamless period. The packet
   visibly travels from the top of the connector to the bottom. */
@keyframes flow-connector-violet {
  0%   { stroke-dashoffset: 100; }
  100% { stroke-dashoffset: 0; }
}
@keyframes flow-connector-cyan {
  0%   { stroke-dashoffset: 100; }
  100% { stroke-dashoffset: 0; }
}
@keyframes card-pulse-violet {
  0%, 70%, 100% { opacity: 0; }
  85%           { opacity: 1; }
  92%           { opacity: .25; }
}
@keyframes card-pulse-cyan {
  0%, 70%, 100% { opacity: 0; }
  85%           { opacity: 1; }
  92%           { opacity: .25; }
}
@keyframes exec-pulse-travel {
  /* small segment slides top → bottom over the 8%→60% window */
  0%   { stroke-dashoffset: 100; opacity: 0; }
  3%   { opacity: 1; }
  8%   { stroke-dashoffset: 100; opacity: 1; }     /* pulse at top of connector */
  60%  { stroke-dashoffset: -14; opacity: 1; }     /* pulse at bottom of connector */
  68%  { opacity: 0; stroke-dashoffset: -14; }
  100% { opacity: 0; stroke-dashoffset: 100; }
}
/* Source-node flash: bright "active" at 3-8%, settle to "completed" after */
@keyframes node-flash-cyan {
  0%, 100%   { box-shadow: none; }
  3%         { box-shadow:
                inset 0 1px 0 color-mix(in srgb, var(--paper) 80%, transparent),
                0 0 0 2px color-mix(in srgb, var(--cyan) 60%, transparent),
                0 6px 18px -6px color-mix(in srgb, var(--cyan) 50%, transparent); }
  10%, 95%   { box-shadow:
                inset 0 1px 0 color-mix(in srgb, var(--paper) 80%, transparent),
                0 0 0 1px color-mix(in srgb, var(--cyan) 24%, transparent); }
}
@keyframes node-flash-violet {
  0%, 100%   { box-shadow: none; }
  3%         { box-shadow:
                inset 0 1px 0 color-mix(in srgb, var(--paper) 80%, transparent),
                0 0 0 2px color-mix(in srgb, var(--violet) 60%, transparent),
                0 6px 18px -6px color-mix(in srgb, var(--violet) 50%, transparent); }
  10%, 95%   { box-shadow:
                inset 0 1px 0 color-mix(in srgb, var(--paper) 80%, transparent),
                0 0 0 1px color-mix(in srgb, var(--violet) 24%, transparent); }
}

/* Universal node flash — used for cards 01 (ROUTE) and 05 (REVIEW).
   Drives the animated gradient border on the ::before pseudo so every
   card in the reliability row participates in the sequential flow. */
@keyframes node-flash-default {
  0%, 100%   { box-shadow: none; }
  3%         { box-shadow:
                inset 0 1px 0 color-mix(in srgb, var(--paper) 80%, transparent),
                0 0 0 2px color-mix(in srgb, var(--node-color, var(--accent)) 60%, transparent),
                0 6px 18px -6px color-mix(in srgb, var(--node-color, var(--accent)) 50%, transparent); }
  10%, 95%   { box-shadow:
                inset 0 1px 0 color-mix(in srgb, var(--paper) 80%, transparent),
                0 0 0 1px color-mix(in srgb, var(--node-color, var(--accent)) 28%, transparent); }
}

/* Drives the ::before gradient ring on every card with each card's own
   --node-color. Animation matches node-flash-default so border and
   shadow pulse together. */
@keyframes node-ring-default {
  0%, 100%   { opacity: .35; }
  3%         { opacity: 1; }
  10%, 95%   { opacity: .7; }
}
/* Card flash: bright at 62-66% (pulse arrives), then a subtle completed border-tint */
@keyframes card-flash-cyan {
  0%, 100%   { border-color: color-mix(in srgb, var(--line) 82%, transparent); }
  62%        { border-color: color-mix(in srgb, var(--cyan) 80%, transparent);
                box-shadow:
                  inset 0 1px 0 color-mix(in srgb, var(--paper) 80%, transparent),
                  0 0 0 2px color-mix(in srgb, var(--cyan) 50%, transparent),
                  0 8px 22px -8px color-mix(in srgb, var(--cyan) 50%, transparent); }
  70%, 95%   { border-color: color-mix(in srgb, var(--cyan) 38%, transparent);
                box-shadow:
                  inset 0 1px 0 color-mix(in srgb, var(--paper) 80%, transparent),
                  0 0 0 1px color-mix(in srgb, var(--cyan) 18%, transparent); }
}
@keyframes card-flash-violet {
  0%, 100%   { border-color: color-mix(in srgb, var(--line) 82%, transparent); }
  62%        { border-color: color-mix(in srgb, var(--violet) 80%, transparent);
                box-shadow:
                  inset 0 1px 0 color-mix(in srgb, var(--paper) 80%, transparent),
                  0 0 0 2px color-mix(in srgb, var(--violet) 50%, transparent),
                  0 8px 22px -8px color-mix(in srgb, var(--violet) 50%, transparent); }
  70%, 95%   { border-color: color-mix(in srgb, var(--violet) 38%, transparent);
                box-shadow:
                  inset 0 1px 0 color-mix(in srgb, var(--paper) 80%, transparent),
                  0 0 0 1px color-mix(in srgb, var(--violet) 18%, transparent); }
}

/* ----------------------------------------------------------------- */
/* Execution pulse — small gradient segment sliding top→bottom       */
/* along each vertical connector, sequentially activating the source  */
/* node, traveling, then activating the target card.                  */
/*                                                                     */
/* Timing model:                                                       */
/*   Each pulse cycle is 6.4s (offset between cyan and violet = 3.2s). */
/*   0% → 8%   : source node "active" flash                           */
/*   8% → 60%  : pulse travels top → bottom                          */
/*   60% → 70% : target card "active" flash                          */
/*   70% → 100%: hold "completed" state, fade for next cycle          */
/* ----------------------------------------------------------------- */
.exec-pulse {
  fill: none;
  stroke-linecap: round;
  stroke-linejoin: round;
  stroke-width: 3.5;          /* thicker, more visible pulse */
  stroke-dasharray: 16 84;    /* slightly larger packet */
  opacity: 0.85;              /* visible immediately */
  will-change: stroke-dashoffset, opacity;
}
.exec-pulse--violet { stroke: url(#exec-pulse-violet); animation: exec-pulse-travel 6.4s cubic-bezier(.55, 0, .45, 1) infinite; }
.exec-pulse--cyan   { stroke: url(#exec-pulse-cyan); animation: exec-pulse-travel 6.4s cubic-bezier(.55, 0, .45, 1) infinite; animation-delay: -3.2s; }

/* Sequential activation of all 5 cards in left → right order.
   Each card's box-shadow + gradient ring share the same delay slot
   (1.28s steps across 6.4s master cycle) so the activation ripple
   flows through the whole row. */
.reliability-loop[data-visible='true'] .reliability-node[data-node='route'] {
  animation: node-flash-default 6.4s ease-in-out infinite;
  animation-delay: 0s;
}
.reliability-loop[data-visible='true'] .reliability-node[data-node='freeze'] {
  animation: node-flash-default 6.4s ease-in-out infinite;
  animation-delay: 1.28s;
}
.reliability-loop[data-visible='true'] .reliability-node[data-node='execute'] {
  animation: node-flash-cyan 6.4s ease-in-out infinite;
  animation-delay: 2.56s;
}
.reliability-loop[data-visible='true'] .reliability-node[data-node='prove'] {
  animation: node-flash-violet 6.4s ease-in-out infinite;
  animation-delay: 3.84s;
}
.reliability-loop[data-visible='true'] .reliability-node[data-node='review'] {
  animation: node-flash-default 6.4s ease-in-out infinite;
  animation-delay: 5.12s;
}

/* Drive the ::before gradient ring on every card with each card's
   own --node-color. The ring breathes and pulses on the same
   schedule as the box-shadow so border and shadow stay in lockstep. */
