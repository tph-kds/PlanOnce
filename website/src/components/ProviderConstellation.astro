---
import ProviderLogo from './ProviderLogo.astro';
import { firstClassProviders, extendedProviders } from '../data/providers';
import { release } from '../data/release.generated';
---
<section class="provider-proof section-compact" id="providers" aria-labelledby="provider-proof-title">
  <div class="container">
    <div class="provider-proof-head reveal">
      <div>
        <div class="kicker">Compatibility, made visible</div>
        <h2 id="provider-proof-title" class="display-sm">{release.firstClassProviderCount} first-class adapters</h2>
      </div>
      <p>One portable skill system across the coding agents teams already use. Authentic provider marks, consistent surface. Tier metadata is explained once — identity stays legible, never noisy.</p>
    </div>
    <ul class="provider-constellation reveal" role="list">
      {firstClassProviders.map((provider) => (
        <li>
          <ProviderLogo provider={provider.id} size="md" decorative={false} />
          <span>{provider.name}</span>
        </li>
      ))}
    </ul>
    <p class="provider-tier-note reveal">
      <strong>Extended:</strong> {extendedProviders.map((provider) => provider.name).join(' · ')}
    </p>
  </div>
</section>

<style>
.provider-proof-head + .provider-constellation + .provider-tier-note { margin-top:0 }
:global(.provider-constellation){
  gap: 12px !important;
}
:global(.provider-constellation li){
  padding: 13px 14px !important;
  gap: 12px !important;
  border-radius: 14px !important;
  background: var(--paper) !important;
  border: 1px solid color-mix(in srgb, var(--line) 88%, transparent) !important;
  box-shadow: 0 2px 10px rgba(15,23,42,.04) !important;
  transition: transform .2s cubic-bezier(.22,1,.36,1), border-color .2s ease, box-shadow .2s ease, background .2s ease !important;
  font-weight: 750 !important;
  font-size: .88rem !important;
  letter-spacing: -.015em;
  color: var(--ink);
}
:global(.provider-constellation li:hover){
  transform: translateY(-2px);
  border-color: color-mix(in srgb, var(--accent) 16%, var(--line)) !important;
  box-shadow: 0 10px 24px rgba(15,23,42,.07) !important;
  background: color-mix(in srgb, var(--paper) 96%, var(--paper-2)) !important;
}
:global([data-theme='dark'] .provider-constellation li){
  background: color-mix(in srgb, var(--paper-2) 42%, var(--paper)) !important;
  border-color: color-mix(in srgb, var(--line) 62%, transparent) !important;
  box-shadow: 0 2px 10px rgba(0,0,0,.14) !important;
}
:global([data-theme='dark'] .provider-constellation li:hover){
  background: color-mix(in srgb, var(--paper-2) 78%, var(--paper)) !important;
  border-color: color-mix(in srgb, var(--accent) 20%, var(--line)) !important;
  box-shadow: 0 10px 24px rgba(0,0,0,.22) !important;
}
:global(.provider-tier-note){
  font-size: .82rem !important;
  color: var(--muted) !important;
  margin-top: 14px !important;
}
:global(.provider-tier-note strong){ color: var(--ink); }
</style>
