---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import GitHubStars from './GitHubStars.astro';
const base = import.meta.env.BASE_URL;
---
<header class="site-header" data-site-header>
  <div class="container header-row">
    <Logo />
    <nav class="desktop-nav" aria-label="Primary">
      <a href={`${base}#workflows`}>Workflows</a>
      <a href={`${base}#reliability`}>Reliability</a>
      <a href={`${base}docs/`}>Docs</a>
      <a href={`${base}docs/providers/`}>Providers</a>
    </nav>
    <div class="header-actions">
      <GitHubStars />
      <button class="icon-button" type="button" data-search-open aria-label="Search"><Icon name="search" /></button>
      <button class="icon-button theme-toggle" type="button" data-theme-toggle aria-label="Toggle color theme"><span class="theme-icon theme-icon-sun"><Icon name="sun" /></span><span class="theme-icon theme-icon-moon"><Icon name="moon" /></span></button>
      <button class="icon-button menu-toggle" type="button" data-menu-toggle aria-label="Open navigation" aria-expanded="false"><Icon name="menu" /></button>
    </div>
  </div>
  <nav class="mobile-menu" data-mobile-menu data-open="false" aria-label="Mobile">
    <a href={`${base}#workflows`}>Workflows</a><a href={`${base}#reliability`}>Reliability</a><a href={`${base}docs/`}>Docs</a><a href={`${base}docs/providers/`}>Providers</a>
  </nav>
</header>
