---
import { workflows } from '../data/site';
const lanes = [
  ['GREENFIELD', workflows.filter((workflow) => workflow.lane === 'greenfield')],
  ['BROWNFIELD', workflows.filter((workflow) => workflow.lane === 'brownfield')],
] as const;
---
<div class="workflow-rails reveal">
  {lanes.map(([label, items]) => (
    <section class="workflow-lane">
      <div class="workflow-lane-label">{label}</div>
      <div class="workflow-path-wrap">
        <svg viewBox="0 0 1000 60" preserveAspectRatio="none" aria-hidden="true"><path data-workflow-path pathLength="1" d="M30 30H970"/></svg>
        <div class="workflow-nodes">
          {items.map((workflow) => <article tabindex="0"><span class="workflow-size">{workflow.size}</span><h3>{workflow.name}</h3><p>{workflow.when}</p><dl><div><dt>Gate</dt><dd>{workflow.gate}</dd></div><div><dt>Artifacts</dt><dd>{workflow.artifacts}</dd></div></dl></article>)}
        </div>
      </div>
    </section>
  ))}
</div>
