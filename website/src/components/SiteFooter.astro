---
import Logo from './Logo.astro';
const base = import.meta.env.BASE_URL;
---
<footer class="site-footer">
  <div class="container footer-grid">
    <div>
      <Logo />
      <p>Open-source production engineering control for building high-quality software with any AI coding agent.</p>
      <div style="margin-top:14px;display:flex;gap:10px;flex-wrap:wrap;align-items:center;">
        <a href="https://github.com/tph-kds/PlanOnce" target="_blank" rel="noopener" style="display:inline-flex;align-items:center;gap:6px;padding:6px 10px;border-radius:999px;border:1px solid var(--line);background:var(--paper);font-size:.78rem;font-weight:700;"><svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/></svg> github.com/tph-kds</a>
        <span style="color:var(--muted);font-size:.78rem;">MIT • Open-source</span>
      </div>
    </div>
    <div>
      <strong>Learn</strong>
      <ul>
        <li><a href={`${base}docs/getting-started/`}>Getting started</a></li>
        <li><a href={`${base}docs/workflows/`}>Workflow guide</a></li>
        <li><a href={`${base}docs/reliability/`}>Reliability layer</a></li>
        <li><a href={`${base}docs/architecture/`}>Runtime architecture</a></li>
      </ul>
    </div>
    <div>
      <strong>Reference</strong>
      <ul>
        <li><a href={`${base}docs/providers/`}>Providers</a></li>
        <li><a href={`${base}docs/security-review/`}>Security and review</a></li>
        <li><a href={`${base}docs/design-system/`}>Design system</a></li>
        <li><a href={`${base}llms.txt`}>llms.txt</a></li>
      </ul>
    </div>
  </div>
  <div class="container" style="margin-top:28px;padding-top:18px;border-top:1px solid var(--line);display:flex;justify-content:space-between;gap:16px;flex-wrap:wrap;align-items:center;color:var(--muted);font-size:.82rem;">
    <span>© {new Date().getFullYear()} <strong style="color:var(--ink);">tph-kds</strong> • PlanOnce — Crafted with discipline. Built for production.</span>
    <span style="display:inline-flex;gap:12px;align-items:center;"><span>v1.0.0</span><span style="opacity:.4;">•</span><span>All rights reserved</span></span>
  </div>
</footer>
