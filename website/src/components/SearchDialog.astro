---
import Icon from './Icon.astro';
---
<dialog class="search-dialog" data-search-dialog aria-labelledby="search-title">
  <div class="search-head"><div><span class="kicker">Command palette</span><strong id="search-title">Search PlanOnce</strong></div><button class="icon-button" type="button" data-search-close aria-label="Close search"><Icon name="x" /></button></div>
  <label class="search-input-wrap"><Icon name="search" /><span class="sr-only">Search documentation</span><input data-search-input placeholder="Search docs, workflows, providers…" autocomplete="off" /></label>
  <div class="search-results" data-search-results></div>
  <footer><span>↑↓ Navigate</span><span>Enter Open</span><span>Esc Close</span></footer>
</dialog>
