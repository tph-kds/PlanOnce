---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SearchDialog from '../components/SearchDialog.astro';
import { searchIndex } from '../data/search';

interface Props { title: string; description: string; }
const { title, description } = Astro.props;
const pageTitle = title === 'PlanOnce' ? 'PlanOnce | Production Engineering Control for AI Coding Agents' : `${title} | PlanOnce`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="application-name" content="PlanOnce" />
    <meta name="theme-color" content="#070a16" />
    <meta name="color-scheme" content="light dark" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`${String(Astro.site).replace(/\/$/, '')}${import.meta.env.BASE_URL}brand/planonce-logo-primary.png`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${String(Astro.site).replace(/\/$/, '')}${import.meta.env.BASE_URL}brand/planonce-logo-primary.png`} />
    <link rel="icon" href={`${import.meta.env.BASE_URL}brand/planonce-mark-primary.png`} type="image/png" />
    <link rel="manifest" href={`${import.meta.env.BASE_URL}site.webmanifest`} />
    <title>{pageTitle}</title>
    <script is:inline>
      (() => {
        const saved = localStorage.getItem('planonce-theme');
        const systemDark = matchMedia('(prefers-color-scheme: dark)').matches;
        document.documentElement.dataset.theme = saved || (systemDark ? 'dark' : 'light');
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <SiteHeader />
    <main id="main"><slot /></main>
    <SiteFooter />
    <SearchDialog />
    <script define:vars={{ searchIndex }}>
      const root = document.documentElement;
      const themeButtons = document.querySelectorAll('[data-theme-toggle]');
      themeButtons.forEach((button) => {
        button.addEventListener('click', () => {
          const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
          root.dataset.theme = next;
          localStorage.setItem('planonce-theme', next);
        });
      });

      const menuButton = document.querySelector('[data-menu-toggle]');
      const mobileMenu = document.querySelector('[data-mobile-menu]');
      menuButton?.addEventListener('click', () => {
        const open = mobileMenu?.getAttribute('data-open') !== 'true';
        mobileMenu?.setAttribute('data-open', String(open));
        menuButton.setAttribute('aria-expanded', String(open));
      });

      document.querySelectorAll('[data-copy]').forEach((button) => {
        button.addEventListener('click', async () => {
          const text = button.getAttribute('data-copy') || '';
          const before = button.textContent;
          try {
            await navigator.clipboard.writeText(text);
            button.textContent = 'Copied';
          } catch {
            button.textContent = 'Select and copy';
          }
          setTimeout(() => { button.textContent = before; }, 1300);
        });
      });

      document.querySelectorAll('[data-provider-tab]').forEach((tab) => {
        tab.addEventListener('click', () => {
          const id = tab.getAttribute('data-provider-tab');
          document.querySelectorAll('[data-provider-tab]').forEach((item) => item.setAttribute('aria-selected', String(item === tab)));
          document.querySelectorAll('[data-provider-panel]').forEach((panel) => panel.setAttribute('data-active', String(panel.getAttribute('data-provider-panel') === id)));
        });
      });

      const reveal = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) entry.target.setAttribute('data-visible', 'true');
        });
      }, { threshold: 0.12 });
      document.querySelectorAll('.reveal').forEach((node) => reveal.observe(node));

      // Fix absolute markdown/docs links for GitHub Pages project site base (/PlanOnce/)
      // Astro components already use base, this handles MDX content links like href="/docs/..."
      const basePath = searchIndex[0]?.href ? new URL(searchIndex[0].href, location.origin).pathname.replace(/docs\/.*/, '') : '/PlanOnce/';
      document.querySelectorAll('a[href^="/"]').forEach((a) => {
        const href = a.getAttribute('href') || '';
        // skip already-prefixed or external or hash-only? only fix docs/llms/brand
        if (href.startsWith('/PlanOnce/') || href === '/') return;
        if (href.startsWith('/docs/') || href.startsWith('/llms') || href.startsWith('/brand/') || href.startsWith('/site.webmanifest')) {
          a.setAttribute('href', basePath.replace(/\/$/, '') + href);
        }
      });

      const dialog = document.querySelector('[data-search-dialog]');
      const input = document.querySelector('[data-search-input]');
      const results = document.querySelector('[data-search-results]');
      const renderSearch = (query = '') => {
        if (!results) return;
        const q = query.trim().toLowerCase();
        const matches = searchIndex.filter((item) => !q || `${item.title} ${item.text}`.toLowerCase().includes(q)).slice(0, 8);
        results.innerHTML = '';
        if (!matches.length) {
          results.innerHTML = '<div class="search-empty">No matching documentation found.</div>';
          return;
        }
        matches.forEach((item) => {
          const link = document.createElement('a');
          link.className = 'search-result';
          link.href = item.href;
          const strong = document.createElement('strong');
          strong.textContent = item.title;
          const span = document.createElement('span');
          span.textContent = item.text;
          link.append(strong, span);
          results.appendChild(link);
        });
      };
      document.querySelectorAll('[data-search-open]').forEach((button) => button.addEventListener('click', () => {
        renderSearch();
        dialog?.showModal();
        input?.focus();
      }));
      document.querySelector('[data-search-close]')?.addEventListener('click', () => dialog?.close());
      input?.addEventListener('input', (event) => renderSearch(event.target.value));
      document.addEventListener('keydown', (event) => {
        if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') {
          event.preventDefault();
          renderSearch();
          dialog?.showModal();
          input?.focus();
        }
        if (event.key === 'Escape' && dialog?.open) dialog.close();
      });
    </script>
  </body>
</html>
