---
import BaseLayout from './BaseLayout.astro';
import '../styles/docs.css';

const { frontmatter } = Astro.props;
const path = Astro.url.pathname;
const base = import.meta.env.BASE_URL;
const nav = [
  [`${base}docs/`, 'Overview'],
  [`${base}docs/getting-started/`, 'Getting started'],
  [`${base}docs/workflows/`, 'Workflows'],
  [`${base}docs/reliability/`, 'Reliability layer'],
  [`${base}docs/architecture/`, 'Runtime architecture'],
  [`${base}docs/providers/`, 'Providers'],
  [`${base}docs/security-review/`, 'Security and review'],
  [`${base}docs/design-system/`, 'Design system']
];
const toc = frontmatter.toc || [];
---
<BaseLayout title={frontmatter.title} description={frontmatter.description}>
  <div class="container docs-shell">
    <aside class="docs-side" aria-label="Documentation navigation">
      <div class="docs-group">Documentation</div>
      <nav>
        {nav.map(([href, label]) => <a href={href} aria-current={path === href ? 'page' : undefined}>{label}</a>)}
      </nav>
      <div class="docs-side-version">
        <span>Current release</span>
        <strong>v1.0.0</strong>
        <span style="margin-top:6px;display:inline-flex;gap:6px;"><span style="width:6px;height:6px;border-radius:50%;background:var(--success);display:inline-block;"></span> Stable</span>
      </div>
    </aside>
    <article class="docs-main">
      <header>
        <div class="kicker">PlanOnce documentation</div>
        <h1 class="display">{frontmatter.heading || frontmatter.title}</h1>
        <p class="muted">{frontmatter.description}</p>
      </header>
      <slot />
      {frontmatter.next && (
        <div class="docs-next">
          <span class="muted">Next</span>
          <a href={frontmatter.next.href.startsWith('/') ? `${base}${frontmatter.next.href.slice(1)}` : frontmatter.next.href}>{frontmatter.next.label} →</a>
        </div>
      )}
    </article>
    <aside class="docs-toc" aria-label="On this page">
      <strong>On this page</strong>
      <nav>
        {toc.map((item) => <a href={`#${item.id}`}>{item.label}</a>)}
      </nav>
    </aside>
  </div>
</BaseLayout>
